---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Langganan - Ngobrolin WEB"
  description="Ikuti Ngobrolin WEB di berbagai platform. Subscribe untuk update episode terbaru setiap Selasa malam."
>
  <section class="py-16">
    <div class="container mx-auto px-4">
      <div class="max-w-2xl mx-auto text-center">
        <h1 class="text-3xl md:text-4xl font-bold text-white mb-4">
          Langganan Ngobrolin WEB
        </h1>
        <p class="text-gray-300 text-lg mb-12">
          Jangan lewatkan episode terbaru! Ikuti kami di platform favoritmu.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 max-w-lg mx-auto">
          <!-- YouTube -->
          <a 
            href="https://www.youtube.com/@RizaFahmi?sub_confirmation=1"
            target="_blank"
            rel="noopener noreferrer"
            class="subscribe-card bg-red-600 hover:bg-red-700"
          >
            <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
            </svg>
            <div class="text-left">
              <span class="block font-semibold">YouTube</span>
              <span class="text-sm opacity-80">Tonton video podcast</span>
            </div>
          </a>

          <!-- Spotify -->
          <a 
            href="https://open.spotify.com/show/1o2d75xrADb9x0AahDO0Ai"
            target="_blank"
            rel="noopener noreferrer"
            class="subscribe-card bg-[#1DB954] hover:bg-[#1ed760]"
          >
            <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
            </svg>
            <div class="text-left">
              <span class="block font-semibold">Spotify</span>
              <span class="text-sm opacity-80">Dengarkan podcast</span>
            </div>
          </a>

          <!-- Apple Podcasts (Coming Soon) -->
          <div class="subscribe-card bg-gradient-to-br from-purple-600/20 to-pink-600/20 cursor-not-allowed border border-purple-500/30">
            <svg class="w-8 h-8 text-purple-400" fill="currentColor" viewBox="0 0 24 24">
              <path d="M5.34 0A5.328 5.328 0 000 5.34v13.32A5.328 5.328 0 005.34 24h13.32A5.328 5.328 0 0024 18.66V5.34A5.328 5.328 0 0018.66 0zm6.525 2.568c4.988 0 9.105 3.762 9.648 8.604h-.001c.033.345.03.65.03.97 0 .32-.002.62-.036.976h-.001a9.728 9.728 0 01-4.47 7.513.403.403 0 01-.596-.166 8.13 8.13 0 00-.644-1.248.403.403 0 01.092-.52 7.91 7.91 0 003.57-5.79 6.598 6.598 0 00.028-.767c0-.26-.002-.524-.03-.787v.001c-.442-3.885-3.746-6.931-7.787-6.931-3.941 0-7.192 2.908-7.74 6.69l-.003.022a8.15 8.15 0 00-.043.96c0 .29.013.58.037.866a7.91 7.91 0 003.567 5.788.403.403 0 01.093.52c-.187.39-.397.81-.644 1.248a.403.403 0 01-.596.166 9.727 9.727 0 01-4.471-7.514c-.034-.357-.034-.66-.034-.975 0-.316-.002-.62.03-.964h-.002c.547-4.823 4.665-8.596 9.652-8.596zm-.001 4.063c2.903 0 5.302 2.167 5.66 4.962.028.27.03.548.03.81 0 .255.002.522-.03.778a5.723 5.723 0 01-2.064 3.91 8.13 8.13 0 00-.345-1.046.403.403 0 01.137-.472 3.908 3.908 0 001.506-2.603c.02-.196.026-.39.029-.58 0-.18-.009-.365-.027-.554-.242-1.89-1.857-3.367-3.836-3.367-1.901 0-3.469 1.374-3.79 3.157l-.009.04a3.916 3.916 0 00-.046.656c0 .21.017.42.045.632.242 1.345.913 2.181 1.552 2.694a.403.403 0 01.137.472 7.63 7.63 0 00-.345 1.046 5.723 5.723 0 01-2.065-3.91c-.031-.256-.028-.523-.028-.778 0-.262-.002-.54.027-.81l.004-.028c.36-2.774 2.752-4.932 5.658-4.931zm-.027 4.01c.986 0 1.792.77 1.855 1.743.005.06.008.126.008.191a1.862 1.862 0 01-.834 1.559v3.109a1.03 1.03 0 01-1.03 1.03 1.03 1.03 0 01-1.03-1.03v-3.11a1.862 1.862 0 01-.834-1.558c0-.065.003-.13.008-.191.063-.973.87-1.743 1.857-1.743z"/>
            </svg>
            <div class="text-left">
              <span class="block font-semibold text-purple-400">Apple Podcasts</span>
              <span class="text-sm text-gray-400">Segera hadir</span>
            </div>
          </div>

          <!-- Podcast RSS Feed -->
          <a 
            href="/podcast-rss.xml"
            class="subscribe-card bg-orange-500/10 hover:bg-orange-500/20 border border-orange-500/30"
          >
            <svg class="w-8 h-8 text-orange-500" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
            </svg>
            <div class="text-left">
              <span class="block font-semibold text-orange-500">Podcast RSS</span>
              <span class="text-sm text-gray-400">Untuk podcast apps</span>
            </div>
          </a>
        </div>

        <!-- Additional Info -->
        <div class="mt-12 p-6 bg-dark-card border border-dark-border rounded-xl">
          <h2 class="text-lg font-semibold text-white mb-3">
            📅 Jadwal Tayang
          </h2>
          <p class="text-gray-300">
            Episode baru setiap <span class="text-primary-light font-medium">Selasa malam jam 20:00 WIB</span>
          </p>
        </div>

        <!-- Social Links -->
        <div class="mt-8">
          <p class="text-gray-400 mb-4">Ikuti diskusi di:</p>
          <div class="flex justify-center gap-4">
            <a 
              href="https://x.com/search?q=%23ngobrolinweb&f=live"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-gray-300 hover:text-white transition"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
              </svg>
              #NgobrolinWEB
            </a>
            <a 
              href="https://github.com/orgs/ngobrolin/discussions"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-2 text-gray-300 hover:text-white transition"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
              </svg>
              GitHub Discussions
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .subscribe-card {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border-radius: 0.75rem;
    color: white;
    transition: all 0.2s ease;
  }
  
  .subscribe-card:not(.cursor-not-allowed):hover {
    transform: scale(1.05);
  }
</style>
