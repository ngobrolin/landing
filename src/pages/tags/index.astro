---
import Layout from '../../layouts/Layout.astro';
import { getAllTagsWithCounts, formatTagLabel } from '../../lib/tags';

const tags = getAllTagsWithCounts();
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://ngobrol.in';

const totalEpisodes = tags.reduce((sum, tag) => sum + tag.count, 0);
const uniqueTags = tags.length;
---

<Layout
  title="Topik - Ngobrolin WEB"
  description={`Jelajahi ${uniqueTags} topik berbeda dari ${totalEpisodes} episode Ngobrolin WEB. Temukan episode berdasarkan topik yang kamu minati.`}
>
  <section class="py-12">
    <div class="container mx-auto px-4">
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-white mb-2">Topik</h1>
        <p class="text-gray-400">
          {uniqueTags} topik dari {totalEpisodes} episode
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
        {tags.map(({ tag, count }) => (
          <a
            href={`/tags/${tag}`}
            class="block p-4 bg-dark-card border border-dark-border rounded-lg hover:border-primary/50 transition group"
          >
            <div class="text-white font-medium group-hover:text-primary-light transition mb-1">
              {formatTagLabel(tag)}
            </div>
            <div class="text-sm text-gray-500">
              {count} episode{count > 1 ? 's' : ''}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
