---
import Layout from '../../layouts/Layout.astro';
import { getAllTagsWithCounts, formatTagLabel, getTaggedEpisodeCount } from '../../lib/tags';
import { getEpisodes } from '../../lib/episodes';

const tags = getAllTagsWithCounts();
const siteUrl = Astro.site?.toString().replace(/\/$/, '') || 'https://ngobrol.in';

// This used to be tags.reduce((sum, t) => sum + t.count, 0), which counts an
// episode once per tag it carries. The page therefore advertised "723 episode"
// against an archive of 178.
const taggedEpisodes = getTaggedEpisodeCount();
const totalEpisodes = getEpisodes().length;
const uniqueTags = tags.length;
---

<Layout
  title="Topik - Ngobrolin WEB"
  description={`Jelajahi ${uniqueTags} topik dari ${taggedEpisodes} episode Ngobrolin WEB. Temukan episode berdasarkan topik yang kamu minati.`}
>
  <section class="py-12">
    <div class="container mx-auto px-4">
      <div class="mb-8">
        <h1 class="text-3xl font-bold text-ink mb-2">Topik</h1>
        <p class="text-ink-muted">
          {uniqueTags} topik · {taggedEpisodes} dari {totalEpisodes} episode sudah diberi topik
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
        {tags.map(({ tag, count }) => (
          <a
            href={`/tags/${tag}`}
            class="block p-4 bg-surface-raised border border-surface-border rounded-lg hover:border-accent/50 transition group"
          >
            <div class="text-ink font-medium group-hover:text-accent-text transition mb-1">
              {formatTagLabel(tag)}
            </div>
            <div class="text-sm text-ink-subtle">
              {count} episode
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
