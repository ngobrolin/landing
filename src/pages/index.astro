---
import Layout from '../layouts/Layout.astro';
import OfflineIndicator from '../components/OfflineIndicator.astro';
import { getEpisodes, formatDuration, getCardBlurb, getKeyPoints } from '../lib/episodes';
import { getDisplayTitle } from '../lib/episode-title';
import { getArchiveStats, getYearsWithCounts, getTopTags, getArchivePicks } from '../lib/archive';
import { formatTagLabel } from '../lib/tags';
import { Image, getImage } from 'astro:assets';
import { generateHomepageSchema } from '../lib/seo';

const episodes = getEpisodes();
const latestEpisode = episodes[0];

// The spotlight already carries episodes[0]; the grid starts after it.
const previousEpisodes = episodes.slice(1, 4);

const { episodeCount, transcriptCount, fullyTranscribed } = getArchiveStats();
const years = getYearsWithCounts();
const topTags = getTopTags(5);
const archivePicks = getArchivePicks(6);

const optimizedLcpImage = await getImage({
  src: latestEpisode.thumbnail,
  width: 640,
  height: 360,
  format: 'webp',
});

const homepageSchema = generateHomepageSchema(
  Astro.site?.toString().replace(/\/$/, '') || 'https://ngobrol.in',
  episodeCount
);

const formatDate = (iso: string, month: 'short' | 'long') =>
  new Date(iso).toLocaleDateString('id-ID', { day: 'numeric', month, year: 'numeric' });

// Absent until someone summarises the newest episode, which lags the weekly sync.
const latestKeyPoints = getKeyPoints(latestEpisode.videoId).slice(0, 3);

const latestDuration = formatDuration(latestEpisode.duration);
const latestDisplayTitle = getDisplayTitle(latestEpisode.title);
// The cover title is sized to its column so the longest word never spills into
// the thumbnail. 0.7em is Archivo's widest per-character advance at this weight
// and width, measured in the browser, with a little clearance.
const longestTitleWord = Math.max(...latestDisplayTitle.split(/\s+/).map((word) => word.length));
const coverTitleSize = `min(clamp(2.75rem, 8.2vw, 7rem), calc(100cqi / ${(longestTitleWord * 0.7).toFixed(2)}))`;
const latestBlurb = getCardBlurb({ brief: latestEpisode.brief, description: latestEpisode.description });

const now = new Date();
const dayOfWeek = new Intl.DateTimeFormat('id-ID', { weekday: 'long', timeZone: 'Asia/Jakarta' }).format(now);
const isTuesday = dayOfWeek.toLowerCase() === 'selasa';

const hosts = [
  {
    name: 'Eka',
    role: 'Pengembang Web • Atma Connect',
    expert: 'GDE Web',
    focus: 'Aksesibilitas & Standar Web',
    image: '/images/eka.jpg',
    github: 'https://github.com/ekafyi',
    x: 'https://x.com/ekafyi',
  },
  {
    name: 'Ivan',
    role: 'Senior Web Engineer • Human Made',
    expert: 'GDE Web',
    focus: 'Platform Konten & Core Web',
    image: '/images/ivan.jpg',
    github: 'https://github.com/ivankristianto',
    x: 'https://x.com/ivankrisdotcom',
  },
  {
    name: 'Riza Fahmi',
    role: 'Co-founder Hacktiv8',
    expert: 'GDE Web',
    focus: 'Tooling Modern & Ekosistem Web',
    image: '/images/riza.jpg',
    github: 'https://github.com/rizafahmi',
    youtube: 'https://www.youtube.com/@RizaFahmi',
    x: 'https://x.com/search?q=%23ngobrolinweb&f=live',
  },
];
---

<Layout
  title="Ngobrolin WEB - Video Podcast Web Development Indonesia"
  preloadImage={optimizedLcpImage.src}
  brandAsHeading
  flushFooter
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(homepageSchema)} />
  </Fragment>

  <!--
    The cover: this week's episode, the way a weekly puts its lead story on the
    front. The one surface on the site that is drenched in the accent, so
    everything inside takes the on-accent tokens and the white focus ring.
  -->
  <section class="on-accent bg-accent-strong text-on-accent" aria-labelledby="home-latest-title">
    <div class="container mx-auto px-4 pt-5 pb-8 md:pt-6 md:pb-12 flex flex-col gap-5 md:gap-7">
      <div class="flex flex-wrap justify-between gap-x-6 gap-y-0.5 text-sm text-on-accent-muted tabular-nums">
        <span><strong class="font-bold text-on-accent">Edisi {latestEpisode.episodeNumber}</strong> · {formatDate(latestEpisode.publishedAt, 'long')}</span>
        {isTuesday ? (
          <span class="inline-flex items-center gap-2 font-semibold text-on-accent">
            <span class="relative flex h-2 w-2" aria-hidden="true">
              <span class="motion-safe:animate-ping absolute inline-flex h-full w-full rounded-full bg-on-accent opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-on-accent"></span>
            </span>
            Livestream malam ini jam 20:00 WIB!
          </span>
        ) : (
          <span>Episode baru setiap Selasa malam jam 20:00 WIB</span>
        )}
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-10 gap-y-5">
        <div class="lg:col-span-5 lg:col-start-8 lg:row-start-1 flex flex-col gap-3.5">
          <Image
            src={latestEpisode.thumbnail}
            alt=""
            width={640}
            height={360}
            format="webp"
            loading="eager"
            fetchpriority="high"
            class="w-full aspect-video object-cover border-4 md:border-[6px] border-on-accent"
          />
          <div class="flex items-center gap-3">
            <div class="flex shrink-0">
              {hosts.map((host, index) => (
                <img
                  src={host.image}
                  alt=""
                  width="44"
                  height="44"
                  loading="lazy"
                  class:list={['w-11 h-11 rounded-full object-cover border-2 border-accent-strong', index > 0 && '-ml-3']}
                />
              ))}
            </div>
            <p class="text-sm text-on-accent-muted">
              <span data-testid="home-tagline">Video podcast seputar web development dalam Bahasa Indonesia.</span>
              Bersama <strong class="text-on-accent font-bold">Riza Fahmi, Eka</strong> dan
              <strong class="text-on-accent font-bold">Ivan</strong>.
            </p>
          </div>
        </div>

        <div class="@container lg:col-span-7 lg:col-start-1 lg:row-start-1 flex flex-col gap-5">
          <h2
            id="home-latest-title"
            class="display leading-[0.95] tracking-[-0.03em]"
            style={`font-size: ${coverTitleSize}`}
          >
            <a href={`/episodes/${latestEpisode.slug}/`} class="hover:underline decoration-4 underline-offset-8" data-testid="home-latest-link">
              {latestDisplayTitle}
            </a>
          </h2>
          {latestBlurb && (
            <p class="max-w-lg text-base md:text-xl leading-normal text-on-accent-muted line-clamp-3">
              {latestBlurb}
            </p>
          )}
          <div class="flex flex-wrap items-center gap-x-4 gap-y-3">
            <a
              href={`/episodes/${latestEpisode.slug}/`}
              class="grow sm:grow-0 inline-flex items-center justify-center min-h-13 px-7 bg-on-accent text-accent-strong hover:bg-on-accent-muted rounded-md font-bold transition"
              data-testid="home-latest-action"
            >
              Tonton &amp; baca transkrip
            </a>
            {latestDuration && (
              <span class="text-sm text-on-accent-muted tabular-nums">{latestDuration}</span>
            )}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- This week on the paper: what the episode says, beside the three before it. -->
  <section class="container mx-auto px-4 py-12 md:py-20">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-x-16 gap-y-12">
      {latestKeyPoints.length > 0 && (
        <div class="lg:col-span-5">
          <h2 class="display text-xl md:text-2xl text-ink mb-5">Di episode ini</h2>
          <ul class="flex flex-col gap-4" data-testid="home-key-points">
            {latestKeyPoints.map((point) => (
              <li class="grid grid-cols-[0.625rem_minmax(0,1fr)] gap-x-3.5 text-[1.0625rem] leading-relaxed text-ink-body">
                <span class="mt-[0.55em] h-2.5 w-2.5 bg-highlight" aria-hidden="true"></span>
                <span>{point}</span>
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class:list={latestKeyPoints.length > 0 ? 'lg:col-span-7' : 'lg:col-span-12'}>
        <h2 class="display text-xl md:text-2xl text-ink mb-3">Episode Sebelumnya</h2>

        <!--
          Rows, not the card grid the archive uses: the cover already spends the
          page's one big picture, and a numbered index reads faster than a
          second set of thumbnails competing with it.
        -->
        <ul class="flex flex-col gap-1">
          {previousEpisodes.map((episode) => (
            <li>
              <a
                href={`/episodes/${episode.slug}/`}
                class="group grid grid-cols-[3rem_5.5rem_minmax(0,1fr)] sm:grid-cols-[4.25rem_7.5rem_minmax(0,1fr)] items-center gap-x-3 sm:gap-x-5 py-2.5 -mx-3 px-3 rounded-lg hover:bg-surface-raised transition"
                data-testid="episode-card"
                data-episode-slug={episode.slug}
              >
                <span class="display text-2xl sm:text-3xl text-accent-text tabular-nums">{episode.episodeNumber}</span>
                <span class="relative block">
                  <Image
                    src={episode.thumbnail}
                    alt=""
                    width={320}
                    height={180}
                    format="webp"
                    loading="lazy"
                    class="w-full aspect-video object-cover rounded-md"
                    transition:name={`episode-thumbnail-${episode.slug}`}
                  />
                  <span class="absolute top-1 right-1 text-on-accent">
                    <OfflineIndicator slug={episode.slug} />
                  </span>
                </span>
                <span class="flex flex-col gap-0.5 min-w-0">
                  <span class="text-lg sm:text-xl font-bold leading-snug text-ink group-hover:text-accent-text transition">
                    {getDisplayTitle(episode.title)}
                  </span>
                  <span class="text-sm text-ink-subtle tabular-nums" data-testid="episode-date">
                    {formatDate(episode.publishedAt, 'short')}
                    {formatDuration(episode.duration) && ` · ${formatDuration(episode.duration)}`}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
        <a href="/episodes/" class="mt-2 inline-flex items-center min-h-11 text-accent-text hover:text-ink transition font-semibold">
          Lihat semua {episodeCount} episode
        </a>
      </div>
    </div>
  </section>

  <!--
    The way into the back catalogue, on its own raised band: search, topics,
    years and a run of older episodes. getTopTags reads the real tag index, so
    every topic here has a page behind it; counts are derived, never typed.
  -->
  <section class="bg-surface-raised py-12 md:py-20" aria-labelledby="home-archive-title">
    <div class="container mx-auto px-4 flex flex-col gap-6">
      <div class="flex flex-col gap-3" data-testid="archive-scale">
        <h2 id="home-archive-title" class="display text-3xl md:text-[2.75rem] leading-none text-ink">Cari di {episodeCount} episode</h2>
        <p class="text-ink-body">
          {fullyTranscribed
            ? 'Semuanya dengan transkrip lengkap.'
            : `${transcriptCount} di antaranya dengan transkrip lengkap.`}
        </p>
      </div>

      <!-- A plain GET to /episodes: works without JavaScript and lands on the ?q= URL the SearchAction schema advertises. -->
      <form action="/episodes/" method="get" role="search" class="flex gap-2 max-w-2xl" data-testid="home-search">
        <label for="home-search-input" class="sr-only">Cari episode</label>
        <input
          type="search"
          id="home-search-input"
          name="q"
          placeholder={`Cari di ${episodeCount} episode...`}
          aria-keyshortcuts="/"
          class="flex-1 min-w-0 h-13 px-4 bg-surface border border-surface-border-strong rounded-md text-ink placeholder-ink-subtle focus:border-accent-text transition"
        />
        <button
          type="submit"
          class="h-13 px-6 bg-accent-strong hover:bg-accent-hover text-on-accent rounded-md font-bold transition"
        >
          Cari
        </button>
      </form>

      <div class="flex flex-col text-ink-subtle tabular-nums">
        {topTags.length > 0 && (
          <p class="flex flex-wrap items-baseline gap-x-5" data-testid="home-topics">
            <span class="min-w-12">Topik</span>
            {topTags.map(({ tag, count }) => (
              <span class="whitespace-nowrap">
                <a
                  href={`/tags/${tag}/`}
                  class="inline-block py-1.5 font-semibold text-accent-text hover:text-ink transition"
                  data-analytics-event="topic_click"
                  data-analytics-props={JSON.stringify({ tag, location: 'home' })}
                >{formatTagLabel(tag)}</a>{' '}
                {count}<span class="sr-only"> episode</span>
              </span>
            ))}
            <a href="/tags/" class="inline-block py-1.5 font-semibold text-accent-text hover:text-ink transition">Semua topik</a>
          </p>
        )}
        <p class="flex flex-wrap items-baseline gap-x-5" data-testid="home-years">
          <span class="min-w-12">Tahun</span>
          {years.map(({ year, count }) => (
            <a
              href={`/episodes/${year}/`}
              class="inline-block py-1.5 font-semibold text-accent-text hover:text-ink transition"
            >{year}<span class="sr-only">, {count} episode</span></a>
          ))}
        </p>
      </div>

      <!--
        Plain links into the back catalogue, a different run each week. Nothing
        else on a page search engines read points at the oldest episodes.
      -->
      {archivePicks.length > 0 && (
        <div class="mt-2" data-testid="home-archive-picks">
          <h3 class="text-sm font-bold text-ink-muted mb-1">Dari arsip</h3>
          <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-x-8">
            {archivePicks.map((episode) => (
              <li>
                <a href={`/episodes/${episode.slug}/`} class="group flex items-baseline gap-3 py-2">
                  <span class="text-sm text-ink-subtle tabular-nums shrink-0">{new Date(episode.publishedAt).getUTCFullYear()}</span>
                  <span class="font-semibold text-ink group-hover:text-accent-text transition">{getDisplayTitle(episode.title)}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )}
    </div>
  </section>

  <section class="container mx-auto px-4 py-12 md:py-20">
    <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 mb-7">
      <h2 class="display text-xl md:text-2xl text-ink">Panelis</h2>
      <a href="/about/" class="inline-flex items-center min-h-11 text-accent-text hover:text-ink transition font-semibold">
        Tentang kami selengkapnya
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-x-8 gap-y-6">
      {hosts.map((host) => (
        <div class="grid grid-cols-[3.5rem_minmax(0,1fr)] gap-x-3.5 items-start">
          <img
            src={host.image}
            alt=""
            class="w-14 h-14 rounded-full object-cover"
            loading="lazy"
            width="56"
            height="56"
          />
          <div class="min-w-0">
            <h3 class="text-ink font-bold text-[1.0625rem]">
              {host.name}
              <span class="ml-1.5 text-xs font-bold text-accent-text">{host.expert}</span>
            </h3>
            <p class="text-ink-body text-[0.9375rem]">{host.role}</p>
            <p class="text-ink-muted text-[0.9375rem]">Fokus: {host.focus}</p>
            <div class="flex flex-wrap items-center gap-x-1 text-[0.9375rem] font-semibold text-accent-text -ml-2">
              {host.github && (
                <a href={host.github} target="_blank" rel="noopener noreferrer" class="min-h-11 px-2 hover:text-ink transition inline-flex items-center">GitHub</a>
              )}
              {host.x && (
                <a href={host.x} target="_blank" rel="noopener noreferrer" class="min-h-11 px-2 hover:text-ink transition inline-flex items-center">X</a>
              )}
              {host.youtube && (
                <a href={host.youtube} target="_blank" rel="noopener noreferrer" class="min-h-11 px-2 hover:text-ink transition inline-flex items-center">YouTube</a>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-surface-overlay py-7 md:py-9">
    <div class="container mx-auto px-4 flex flex-wrap items-center justify-between gap-x-8 gap-y-2">
      <h2 class="text-lg font-semibold text-ink">Punya Pertanyaan atau Topik Diskusi?</h2>
      <div class="flex flex-wrap items-center gap-x-6 gap-y-1">
        <a
          href="https://github.com/orgs/ngobrolin/discussions"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center min-h-11 font-semibold text-accent-text hover:text-ink transition"
        >
          GitHub Discussions
        </a>
        <a
          href="https://www.youtube.com/@RizaFahmi?sub_confirmation=1"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center min-h-11 font-semibold text-accent-text hover:text-ink transition"
          data-analytics-event="subscribe_click"
          data-analytics-props={JSON.stringify({ dest: 'youtube', location: 'home_community' })}
        >
          Subscribe YouTube
        </a>
        <a
          href="/subscribe/"
          class="inline-flex items-center min-h-11 px-5 bg-accent-strong hover:bg-accent-hover text-on-accent rounded-md font-bold transition"
        >
          Langganan
        </a>
      </div>
    </div>
  </section>

  <!-- Client-side keyboard shortcut listener for search -->
  <script is:inline data-astro-rerun>
    (() => {
      if (document.documentElement.dataset.searchShortcutInit === 'true') return;
      document.documentElement.dataset.searchShortcutInit = 'true';
      window.addEventListener('keydown', (e) => {
        const searchInput = document.getElementById('home-search-input');
        if (!searchInput) return;

        // Press '/' (without Cmd/Ctrl/Alt modifiers) outside editable elements to focus
        if (
          e.key === '/' &&
          !e.metaKey &&
          !e.ctrlKey &&
          !e.altKey &&
          !['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement?.tagName) &&
          !document.activeElement?.isContentEditable
        ) {
          e.preventDefault();
          searchInput.focus();
        }

        // Press 'Escape' while search is focused to blur
        if (e.key === 'Escape' && document.activeElement === searchInput) {
          searchInput.blur();
        }
      });
    })();
  </script>
</Layout>
