---
import Layout from "../../layouts/Layout.astro";
import EpisodeMedia from "../../components/EpisodeMedia.astro";
import Transcript from "../../components/Transcript.astro";
import Summary from "../../components/Summary.astro";
import { getEpisodes, formatDuration, type Episode } from "../../lib/episodes";
import { getImage } from "astro:assets";
import {
    getSummary,
    getTranscript,
    getMetaDescription,
    generateVideoSchema,
    generateBreadcrumbSchema,
    generatePodcastEpisodeSchema,
    getEpisodePageTitle,
    getDisplayTitle,
} from "../../lib/seo";
import { getRelatedEpisodes } from "../../lib/related";
import Comments from "../../components/Comments.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import EpisodeTopics from "../../components/EpisodeTopics.astro";
import { getDeck } from "../../lib/transcript-view";

export async function getStaticPaths() {
    const episodes = getEpisodes();
    return episodes.map((episode) => ({
        params: { slug: episode.slug },
        props: { episode },
    }));
}

interface Props {
    episode: Episode;
}

const { episode } = Astro.props;

const optimizedThumbnail = await getImage({
    src: episode.thumbnail,
    width: 640,
    height: 360,
    format: "webp",
});

const formattedDate = new Date(episode.publishedAt).toLocaleDateString(
    "id-ID",
    {
        weekday: "long",
        day: "numeric",
        month: "long",
        year: "numeric",
    },
);

const episodes = getEpisodes();
const currentIndex = episodes.findIndex((e) => e.videoId === episode.videoId);
const prevEpisode =
    currentIndex < episodes.length - 1 ? episodes[currentIndex + 1] : null;
const nextEpisode = currentIndex > 0 ? episodes[currentIndex - 1] : null;

// SEO data
const summary = getSummary(episode.videoId);
const transcript = getTranscript(episode.videoId);
const metaDescription = getMetaDescription(episode, summary);
const siteUrl =
    Astro.site?.toString().replace(/\/$/, "") || "https://ngobrol.in";

const videoSchema = generateVideoSchema(episode, summary, transcript, siteUrl);
const breadcrumbSchema = generateBreadcrumbSchema(episode, siteUrl);
const podcastSchema = generatePodcastEpisodeSchema(episode, summary, siteUrl);

// Six, not three: related links are the main path from a page a search engine
// reads into the older episodes nothing else on the site points at.
const relatedEpisodes = getRelatedEpisodes(episode, episodes, 6);
const duration = formatDuration(episode.duration);

// Episode URL for sharing
const episodeUrl = `${siteUrl}/episodes/${episode.slug}`;

// Visible text drops the trailing show-name credit; the <title>, og:title and
// the share text keep it.
const displayTitle = getDisplayTitle(episode.title);
const deck = getDeck(summary?.brief);

const shortDate = (iso: string) =>
    new Date(iso).toLocaleDateString("id-ID", { day: "numeric", month: "short", year: "numeric" });
---

<Layout
    title={getEpisodePageTitle(episode, summary)}
    description={metaDescription}
    image={episode.thumbnail}
    preloadImage={optimizedThumbnail.src}
    ogType="video.other"
>
    <!-- Structured Data -->
    <Fragment slot="head">
        <script
            type="application/ld+json"
            set:html={JSON.stringify(videoSchema)}
        />
        <script
            type="application/ld+json"
            set:html={JSON.stringify(breadcrumbSchema)}
        />
        <script
            type="application/ld+json"
            set:html={JSON.stringify(podcastSchema)}
        />
    </Fragment>
    <article class="pt-8 md:pt-12">
        <div class="container mx-auto px-4">
            <div class="max-w-4xl mx-auto">
                <nav aria-label="Breadcrumb" class="mb-5">
                    <ol class="flex items-center gap-2 text-sm text-ink-muted">
                        <li>
                            <a href="/" class="hover:text-ink transition">Beranda</a>
                        </li>
                        <li aria-hidden="true">/</li>
                        <li>
                            <a href="/episodes/" class="hover:text-ink transition">Episode</a>
                        </li>
                        <li aria-hidden="true">/</li>
                        <li class="text-ink truncate min-w-0" aria-current="page">{displayTitle}</li>
                    </ol>
                </nav>

                <!--
                    Title before the player. Most arrivals come from a search
                    for a topic, not for the show, so the first thing they read
                    confirms they landed on the right page.
                -->
                <h1 class:list={["display text-[clamp(2rem,6vw,3.5rem)] leading-none text-ink", deck ? "mb-4" : "mb-6"]}>
                    {displayTitle}
                </h1>
                {deck && (
                    <p class="max-w-[44rem] text-xl leading-snug text-ink mb-6" data-testid="episode-deck">
                        {deck}
                    </p>
                )}

                <!-- EpisodeMedia sets the Video / Audio saja toggle on this row, so the meta line costs no extra height. -->
                <EpisodeMedia
                    episode={episode}
                    displayTitle={displayTitle}
                    thumbnail={optimizedThumbnail.src}
                    transitionName={`episode-thumbnail-${episode.slug}`}
                >
                    <p slot="lead" class="text-sm text-ink-muted tabular-nums">
                        <span class="font-bold text-ink" data-testid="episode-number-badge">EP {episode.episodeNumber}</span>
                        <span aria-hidden="true"> · </span>
                        <time datetime={episode.publishedAt}>{formattedDate}</time>
                        {duration && (
                            <>
                                <span aria-hidden="true"> · </span>
                                {duration}
                            </>
                        )}
                    </p>
                </EpisodeMedia>

                <!--
                    Key points first, then the search into the transcript,
                    then the raw YouTube description. The description is the
                    weakest of the three for a reader: most of them are
                    boilerplate, and it carries sponsor ad copy.
                -->
                <div class="mt-10 md:mt-14">
                    <Summary videoId={episode.videoId} />
                </div>
            </div>
        </div>

        <!-- The transcript as a tool, on its own raised band like the homepage archive. -->
        <div class:list={["mt-10 md:mt-14", transcript && "bg-surface-raised py-12 md:py-16"]}>
            <div class="container mx-auto px-4">
                <div class="max-w-4xl mx-auto">
                    <Transcript videoId={episode.videoId} />

                    <details class="mt-2">
                        <summary
                            class="inline-flex items-center min-h-11 cursor-pointer text-ink-muted hover:text-ink transition text-sm font-medium"
                        >
                            Deskripsi asli dari YouTube
                        </summary>
                        <p
                            class="max-w-[68ch] text-ink-body leading-relaxed whitespace-pre-line mt-2"
                        >
                            {episode.description}
                        </p>
                    </details>
                </div>
            </div>
        </div>

        <div class="container mx-auto px-4">
            <div class="max-w-4xl mx-auto">
                <!--
                    Rows, not cards: six thumbnails took a quarter of a
                    phone's page for links a reader scans by title.
                -->
                {
                    relatedEpisodes.length > 0 && (
                        <section class="pt-12 md:pt-16" data-testid="related-episodes">
                            <h2 class="display text-xl md:text-2xl text-ink mb-3">
                                Episode Terkait
                            </h2>
                            <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-12">
                                {relatedEpisodes.map((ep) => (
                                    <li>
                                        <a
                                            href={`/episodes/${ep.slug}/`}
                                            class="group grid grid-cols-[3.25rem_minmax(0,1fr)] items-baseline gap-x-3.5 py-2.5"
                                            data-testid="related-episode"
                                        >
                                            <span class="display text-xl text-accent-text tabular-nums">{ep.episodeNumber}</span>
                                            <span class="flex flex-col gap-0.5 min-w-0">
                                                <span class="text-lg font-bold leading-snug text-ink group-hover:text-accent-text transition">
                                                    {getDisplayTitle(ep.title)}
                                                </span>
                                                <span class="text-sm text-ink-subtle tabular-nums">
                                                    {shortDate(ep.publishedAt)}
                                                    {formatDuration(ep.duration) && ` · ${formatDuration(ep.duration)}`}
                                                </span>
                                            </span>
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </section>
                    )
                }

                <!-- The page's only outbound path into the subject archive, and what gives the tag pages their inbound links. -->
                <div class:list={relatedEpisodes.length > 0 ? "mt-4" : "pt-12"}>
                    <EpisodeTopics videoId={episode.videoId} />
                </div>
            </div>
        </div>

                    <!--
                        Subscribe, at the end of the episode.

                        The homepage hero keeps the one-click YouTube link with
                        its confirm dialog, because a front door wants the
                        lowest-friction action. Here it is the opposite: someone
                        who just finished an 85-minute episode is exactly who
                        wants to choose a platform, so this names all three and
                        sends them to /subscribe rather than being a second
                        YouTube button.
                    -->
        <section
            class="mt-12 md:mt-16 bg-surface-overlay py-9 md:py-11"
            aria-labelledby="episode-subscribe-heading"
        >
            <div class="container mx-auto px-4">
                <div class="max-w-4xl mx-auto">
                    <div data-testid="episode-subscribe">
                        <div
                            class="flex flex-col md:flex-row md:items-center justify-between gap-5"
                        >
                            <div>
                                <h2
                                    id="episode-subscribe-heading"
                                    class="text-ink font-semibold text-lg mb-1"
                                >
                                    Suka episode ini?
                                </h2>
                                <p class="text-ink-muted text-sm">
                                    Episode baru setiap Selasa malam. Dengarkan
                                    lewat <span class="text-ink-body">YouTube</span>,
                                    <span class="text-ink-body">Spotify</span>, atau
                                    feed <span class="text-ink-body">podcast</span>
                                    favoritmu.
                                </p>
                            </div>
                            <a
                                href="/subscribe/"
                                class="bg-accent-strong hover:bg-accent-hover text-on-accent px-6 py-3 rounded-lg font-medium transition whitespace-nowrap text-center"
                                data-analytics-event="cta_click"
                                data-analytics-props={JSON.stringify({
                                    cta: "subscribe",
                                    location: "episode_page",
                                    videoId: episode.videoId,
                                })}
                            >
                                Pilih Cara Langganan
                            </a>
                        </div>
                    </div>

                    <!--
                        Two quiet lines under the subscribe card, for the two
                        audiences that are NOT the listener the card just spoke
                        to. Both stay at text-sm/ink-muted on purpose: the
                        subscribe CTA is the page's one loud ask and a second
                        filled button beside it would weaken both.

                        The second line is the only path from an episode to
                        /partners. Every episode page previously linked it
                        zero times, which both starved the sponsor page of
                        internal-link signal and wasted the one moment the
                        intent exists - someone who just finished an episode
                        and thinks "I could advertise here". It is worded for a
                        partnerships or marketing reader, not a developer, and
                        echoes the /partners H1 so the click has scent.
                    -->
                    <div
                        class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm"
                    >
                        <a
                            href="https://github.com/orgs/ngobrolin/discussions"
                            target="_blank"
                            rel="noopener noreferrer"
                            class="text-ink-muted hover:text-ink transition flex items-center gap-2"
                            data-analytics-event="outbound_click"
                            data-analytics-props={JSON.stringify({
                                dest: "github_discussions",
                                location: "episode_page",
                                videoId: episode.videoId,
                            })}
                        >
                            <svg
                                class="w-5 h-5"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"
                                ></path>
                            </svg>
                            Diskusikan episode ini di GitHub
                        </a>
                        <a
                            href="/partners/"
                            class="text-ink-muted hover:text-ink transition flex items-center gap-2"
                            data-testid="episode-partners-link"
                            data-analytics-event="cta_click"
                            data-analytics-props={JSON.stringify({
                                cta: "partners",
                                location: "episode_page",
                                videoId: episode.videoId,
                            })}
                        >
                            <svg
                                class="w-5 h-5"
                                fill="currentColor"
                                viewBox="0 0 24 24"
                                aria-hidden="true"
                            >
                                <path
                                    d="M18 11v2h4v-2h-4zm-2 6.61c.96.71 2.21 1.65 3.2 2.39.4-.53.8-1.07 1.2-1.6-.99-.74-2.24-1.68-3.2-2.4-.4.54-.8 1.08-1.2 1.61zM20.4 5.6c-.4-.53-.8-1.07-1.2-1.6-.99.74-2.24 1.68-3.2 2.4.4.53.8 1.07 1.2 1.6.96-.72 2.21-1.65 3.2-2.4zM4 9c-1.1 0-2 .9-2 2v2c0 1.1.9 2 2 2h1v4h2v-4h1l5 3V6L8 9H4zm11.5 3c0-1.33-.58-2.53-1.5-3.35v6.69c.92-.81 1.5-2.01 1.5-3.34z"
                                ></path>
                            </svg>
                            Sponsor &amp; pasang iklan di podcast ini
                        </a>
                    </div>

                    <!--
                        Share sits after the content and the related rows. It
                        used to be the first interactive thing under the H1,
                        which asked a first-time visitor to share an episode
                        they had not read.
                    -->
                    <div class="mt-5">
                        <ShareButtons url={episodeUrl} title={episode.title} />
                    </div>
                </div>
            </div>
        </section>

        <div class="container mx-auto px-4 pb-8 md:pb-12">
            <div class="max-w-4xl mx-auto">

                <!-- Comments -->
                <Comments />

                <!-- Navigation -->
                <nav
                    class="mt-12"
                    aria-label="Episode sebelumnya dan selanjutnya"
                >
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        {
                            prevEpisode ? (
                                <a
                                    href={`/episodes/${prevEpisode.slug}/`}
                                    class="p-4 bg-surface-raised border border-surface-border rounded-lg hover:border-accent/50 transition group"
                                >
                                    <span class="text-ink-muted text-sm">Episode Sebelumnya</span>
                                    <p class="text-ink font-medium mt-1 group-hover:text-accent-text transition line-clamp-1">
                                        {getDisplayTitle(prevEpisode.title)}
                                    </p>
                                </a>
                            ) : (
                                <div class="hidden sm:block" />
                            )
                        }

                        {
                            nextEpisode ? (
                                <a
                                    href={`/episodes/${nextEpisode.slug}/`}
                                    class="p-4 bg-surface-raised border border-surface-border rounded-lg hover:border-accent/50 transition group sm:text-right"
                                >
                                    <span class="text-ink-muted text-sm">Episode Selanjutnya</span>
                                    <p class="text-ink font-medium mt-1 group-hover:text-accent-text transition line-clamp-1">
                                        {getDisplayTitle(nextEpisode.title)}
                                    </p>
                                </a>
                            ) : (
                                <div class="hidden sm:block" />
                            )
                        }
                    </div>
                </nav>
            </div>
        </div>
    </article>
</Layout>

<style>
    .line-clamp-1 {
        display: -webkit-box;
        -webkit-line-clamp: 1;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>
