---
import "../styles/global.css";
import { ClientRouter } from "astro:transitions";
import Analytics from "../components/Analytics.astro";
import ScrollButtons from "../components/ScrollButtons.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
  preloadImage?: string;
  omitCanonical?: boolean;
  ogType?: string;
}

const {
  title,
  description = "Video podcast seputar web development. Hadir setiap Selasa malam jam 20:00 WIB.",
  image = "/og-image.png",
  preloadImage,
  omitCanonical = false,
  ogType = "website",
} = Astro.props;

const site = Astro.site ?? new URL(Astro.url.origin);
const canonicalURL = new URL(Astro.url.pathname, site);
const absoluteImage = image.startsWith("http")
  ? image
  : new URL(image, site).toString();

const siteUrl = site.toString().replace(/\/$/, "");
const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      name: "Ngobrolin WEB",
      url: siteUrl,
      logo: {
        "@type": "ImageObject",
        url: new URL("/og-image.png", site).toString(),
      },
      sameAs: [
        "https://www.youtube.com/@RizaFahmi",
        "https://open.spotify.com/show/1o2d75xrADb9x0AahDO0Ai",
        "https://github.com/orgs/ngobrolin/discussions",
        "https://x.com/search?q=%23ngobrolinweb&f=live",
      ],
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      url: siteUrl,
      name: "Ngobrolin WEB",
      description,
      publisher: { "@id": `${siteUrl}/#organization` },
      inLanguage: "id-ID",
      potentialAction: {
        "@type": "SearchAction",
        target: `${siteUrl}/episodes/?q={search_term_string}`,
        "query-input": "required name=search_term_string",
      },
    },
    {
      "@type": "WebPage",
      "@id": `${canonicalURL.toString()}#webpage`,
      url: canonicalURL.toString(),
      name: title,
      description,
      isPartOf: { "@id": `${siteUrl}/#website` },
      inLanguage: "id-ID",
      primaryImageOfPage: { "@type": "ImageObject", url: absoluteImage },
    },
  ],
};
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- Performance -->
    {
      preloadImage && (
        <link
          rel="preload"
          as="image"
          href={preloadImage}
          fetchpriority="high"
        />
      )
    }

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    {!omitCanonical && <link rel="canonical" href={canonicalURL} />}
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={absoluteImage} />
    <meta property="og:site_name" content="Ngobrolin WEB" />
    <meta property="og:locale" content="id_ID" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={absoluteImage} />

    <!-- RSS -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ngobrolin WEB RSS Feed"
      href="/rss.xml"
    />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Ngobrolin WEB Podcast"
      href="/podcast-rss.xml"
    />

    <!-- Additional head content -->
    <slot name="head" />

    <!-- Speculation Rules API for prefetch/prerender -->
    <script type="speculationrules">
{
  "prefetch": [{
    "source": "document",
    "where": { "href_matches": "/episodes/*" },
    "eagerness": "eager"
  }],
  "prerender": [{
    "source": "list",
    "urls": ["/episodes"]
  }]
}
</script>

    <!-- Analytics (optional; configured via PUBLIC_UMAMI_* env vars) -->
    <Analytics />

    <!-- Service Worker Registration -->
    <script is:inline data-astro-rerun>
      (function registerServiceWorker() {
        // Feature detection
        if (!('serviceWorker' in navigator)) {
          console.log('[SW] Service Worker not supported in this browser');
          return;
        }

        // Guard: Prevent duplicate registration
        if (navigator.serviceWorker.controller) {
          console.log('[SW] Already controlled by:', navigator.serviceWorker.controller.scriptURL);
          return;
        }

        // Register Service Worker
        navigator.serviceWorker.register('/sw.js')
          .then((registration) => {
            console.log('[SW] Registered successfully:', registration.scope);

            // Listen for new Service Worker versions
            registration.addEventListener('updatefound', () => {
              const newWorker = registration.installing;
              if (newWorker) {
                console.log('[SW] New version detected, installing...');
                newWorker.addEventListener('statechange', () => {
                  if (newWorker.state === 'installed' && navigator.serviceWorker.controller) {
                    console.log('[SW] New version available. Refresh to update.');
                  }
                });
              }
            });
          })
          .catch((err) => {
            console.error('[SW] Registration failed:', err);
          });
      })();
    </script>

    <!-- View Transitions Custom Duration -->
    <style is:global>
      @keyframes astroFade {
        from {
          opacity: 0;
        }
        to {
          opacity: 1;
        }
      }
      ::view-transition-old(root),
      ::view-transition-new(root) {
        animation-duration: 150ms;
      }
    </style>
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-dark-border">
      <nav
        class="container mx-auto px-4 py-4 flex items-center justify-between"
      >
        <a
          href="/"
          class="text-xl font-bold text-white hover:text-primary-light transition"
        >
          Ngobrolin WEB
        </a>

        <!-- Desktop Navigation -->
        <div class="hidden md:flex items-center gap-6">
          <a href="/episodes" class="text-gray-300 hover:text-white transition"
            >Episode</a
          >
          <a href="/tags" class="text-gray-300 hover:text-white transition"
            >Topik</a
          >
          <a href="/partners" class="text-gray-300 hover:text-white transition"
            >Partner</a
          >
          <a
            href="https://github.com/orgs/ngobrolin/discussions"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-300 hover:text-white transition"
            data-analytics-event="outbound_click"
            data-analytics-props={JSON.stringify({
              dest: "github_discussions",
              location: "nav_desktop",
            })}>Diskusi</a
          >
          <a href="/about" class="text-gray-300 hover:text-white transition"
            >Tentang</a
          >
          <a
            href="/subscribe"
            class="bg-red-600 hover:bg-red-700 text-white px-4 py-2 rounded-lg text-sm font-medium transition"
            data-analytics-event="cta_click"
            data-analytics-props={JSON.stringify({
              cta: "subscribe",
              location: "nav_desktop",
            })}
          >
            Langganan
          </a>
        </div>

        <!-- Mobile Menu Button -->
        <button
          type="button"
          class="md:hidden p-2 text-gray-300 hover:text-white transition"
          id="mobile-menu-btn"
          aria-label="Buka menu"
          aria-expanded="false"
        >
          <svg
            class="w-6 h-6 menu-icon"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg
            class="w-6 h-6 close-icon hidden"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </nav>

      <!-- Mobile Navigation Overlay -->
      <div
        id="mobile-menu"
        class="hidden md:hidden bg-dark border-t border-dark-border"
      >
        <div class="container mx-auto px-4 py-4 flex flex-col gap-4">
          <a
            href="/episodes"
            class="text-gray-300 hover:text-white transition py-2">Episode</a
          >
          <a
            href="/tags"
            class="text-gray-300 hover:text-white transition py-2">Topik</a
          >
          <a
            href="/partners"
            class="text-gray-300 hover:text-white transition py-2">Partner</a
          >
          <a
            href="https://github.com/orgs/ngobrolin/discussions"
            target="_blank"
            rel="noopener noreferrer"
            class="text-gray-300 hover:text-white transition py-2"
            data-analytics-event="outbound_click"
            data-analytics-props={JSON.stringify({
              dest: "github_discussions",
              location: "nav_mobile",
            })}>Diskusi</a
          >
          <a
            href="/about"
            class="text-gray-300 hover:text-white transition py-2">Tentang</a
          >
          <a
            href="/subscribe"
            class="bg-red-600 hover:bg-red-700 text-white px-4 py-3 rounded-lg text-sm font-medium transition text-center mt-2"
            data-analytics-event="cta_click"
            data-analytics-props={JSON.stringify({
              cta: "subscribe",
              location: "nav_mobile",
            })}
          >
            Langganan
          </a>
        </div>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-dark-border mt-16">
      <div class="container mx-auto px-4 py-8">
        <div
          class="flex flex-col md:flex-row justify-between items-center gap-4"
        >
          <p class="text-gray-400 text-sm">
            © {new Date().getFullYear()} Ngobrolin WEB. Hadir setiap Selasa 20:00
            WIB.
          </p>
          <div class="flex items-center gap-4">
            <a
              href="https://www.youtube.com/@RizaFahmi"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-400 hover:text-white transition"
              data-analytics-event="outbound_click"
              data-analytics-props={JSON.stringify({
                dest: "youtube_channel",
                location: "footer",
              })}
            >
              YouTube
            </a>
            <a
              href="https://x.com/search?q=%23ngobrolinweb&f=live"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-400 hover:text-white transition"
              data-analytics-event="outbound_click"
              data-analytics-props={JSON.stringify({
                dest: "x_hashtag",
                location: "footer",
              })}
            >
              X
            </a>
            <a
              href="https://open.spotify.com/show/1o2d75xrADb9x0AahDO0Ai"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-400 hover:text-[#1DB954] transition flex items-center gap-1"
              title="Spotify"
              data-analytics-event="outbound_click"
              data-analytics-props={JSON.stringify({
                dest: "spotify_show",
                location: "footer",
              })}
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"/>
              </svg>
              Spotify
            </a>
            <a
              href="https://github.com/ngobrolin/landing"
              target="_blank"
              rel="noopener noreferrer"
              class="text-gray-400 hover:text-white transition flex items-center gap-1"
              title="GitHub Repository"
              data-analytics-event="outbound_click"
              data-analytics-props={JSON.stringify({
                dest: "github_repo",
                location: "footer",
              })}
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 2.649-.399.667 0 1.236.024 1.651.133 1.651 1.133 0 2.854-.989 3.17-1.673 2.864-5.219 5.299-4.866 5.299-5.903 0-5.713-2.854-5.713-6.347 0-1.253.442-2.595 1.537-3.687-1.053-.306-2.163-.822-3.932-1.193-5.762-.594-1.416.511-2.361 1.695-4.576.594 1.068-.667 1.537-1.188 1.537-1.188z"/>
              </svg>
              GitHub
            </a>
            <a
              href="/podcast-rss.xml"
              class="text-gray-400 hover:text-orange-500 transition flex items-center gap-1"
              title="Podcast RSS Feed"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path
                  d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"
                ></path>
              </svg>
              RSS
            </a>
          </div>
        </div>
      </div>
    </footer>

    <!-- View Transitions (deferred to avoid blocking critical path) -->
    <ClientRouter />

    <!-- Scroll Buttons -->
    <ScrollButtons />

    <!-- Mobile Menu Toggle Script -->
    <script is:inline data-astro-rerun>
      (function initMobileMenu() {
        const menuBtn = document.getElementById("mobile-menu-btn");
        const mobileMenu = document.getElementById("mobile-menu");
        const menuIcon = menuBtn?.querySelector(".menu-icon");
        const closeIcon = menuBtn?.querySelector(".close-icon");

        if (!menuBtn || !mobileMenu) return;

        // Skip if already initialized (prevents duplicate listeners after view transitions)
        if (menuBtn.hasAttribute("data-menu-initialized")) return;
        menuBtn.setAttribute("data-menu-initialized", "true");

        menuBtn.addEventListener("click", () => {
          const isOpen = mobileMenu?.classList.toggle("hidden") === false;

          menuIcon?.classList.toggle("hidden", isOpen);
          closeIcon?.classList.toggle("hidden", !isOpen);
          menuBtn?.setAttribute("aria-expanded", String(isOpen));
        });

        // Close menu when clicking a link
        mobileMenu?.querySelectorAll("a").forEach((link) => {
          link.addEventListener("click", () => {
            mobileMenu.classList.add("hidden");
            menuIcon?.classList.remove("hidden");
            closeIcon?.classList.add("hidden");
            menuBtn?.setAttribute("aria-expanded", "false");
          });
        });
      })();
    </script>

  </body>
</html>
