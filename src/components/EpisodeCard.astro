---
import { Image } from 'astro:assets';
import OfflineIndicator from './OfflineIndicator.astro';
import { formatDuration, getCardBlurb } from '../lib/episodes';
import { getDisplayTitle } from '../lib/episode-title';

interface Props {
  title: string;
  description: string;
  publishedAt: string;
  thumbnail: string;
  episodeNumber: number;
  slug: string;
  isNew?: boolean;
  loading?: "lazy" | "eager";
  fetchPriority?: "high" | "low" | "auto";
  brief?: string;
  duration?: string;
}

const {
  title,
  description,
  publishedAt,
  thumbnail,
  episodeNumber,
  slug,
  isNew = false,
  loading = "lazy",
  fetchPriority,
  brief,
  duration,
} = Astro.props;

const formattedDate = new Date(publishedAt).toLocaleDateString('id-ID', {
  day: 'numeric',
  month: 'short',
  year: 'numeric'
});

// 109 of 178 descriptions were the same sentence, so the blurb line was noise
// across most of the grid. getCardBlurb returns null when nothing informative
// survives, and the card simply omits the line rather than repeating itself.
const blurb = getCardBlurb({ brief, description });
const truncatedBlurb =
  blurb && blurb.length > 120 ? `${blurb.slice(0, 120)}...` : blurb;

const readableDuration = formatDuration(duration);

// The show name belongs in the browser title, not on every card of a site
// already called Ngobrolin WEB.
const displayTitle = getDisplayTitle(title);
---

<a
  href={`/episodes/${slug}`}
  class="group block bg-dark-card border border-dark-border rounded-xl overflow-hidden hover:border-primary/50 transition-all duration-300 hover:shadow-lg hover:shadow-primary/10"
  data-testid="episode-card"
  data-episode-slug={slug}
>
  <div class="relative aspect-video overflow-hidden">
    <Image
      src={thumbnail}
      alt={displayTitle}
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
      loading={loading}
      fetchpriority={fetchPriority}
      width={640}
      height={360}
      format="webp"
      transition:name={`episode-thumbnail-${slug}`}
    />
    {isNew && (
      <span class="absolute top-3 left-3 bg-primary text-white text-xs font-bold px-2 py-1 rounded">
        BARU
      </span>
    )}
    <div class="absolute bottom-3 left-3 bg-black/70 text-white text-xs font-medium px-2 py-1 rounded">
      EP {episodeNumber}
    </div>
    {readableDuration && (
      <div
        class="absolute bottom-3 right-3 bg-black/70 text-white text-xs font-medium px-2 py-1 rounded"
        data-testid="episode-duration"
      >
        {readableDuration}
      </div>
    )}
    <div class="absolute top-3 right-3">
      <OfflineIndicator slug={slug} />
    </div>
  </div>
  <div class="p-4">
    <p class="text-gray-400 text-xs mb-2">{formattedDate}</p>
    <h3 class="text-white font-semibold mb-2 group-hover:text-primary-light transition line-clamp-2">
      {displayTitle}
    </h3>
    {truncatedBlurb && (
      <p class="text-gray-400 text-sm line-clamp-2">
        {truncatedBlurb}
      </p>
    )}
  </div>
</a>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
