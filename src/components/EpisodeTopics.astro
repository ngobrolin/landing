---
import { getEpisodeTags, formatTagLabel } from "../lib/tags";

interface Props {
  videoId: string;
  /** Heading text for screen readers; the chips are self-evident visually. */
  label?: string;
}

const { videoId, label = "Topik episode ini" } = Astro.props;

// Tags are derived from summaries, so an episode without a summary - or one
// whose summary matched no known tag - has none. Render nothing at all rather
// than an empty shell with a heading and no chips.
const tags = getEpisodeTags(videoId);
---

{
  tags.length > 0 && (
    <nav
      class="flex flex-wrap items-baseline gap-x-5 text-ink-subtle"
      aria-label={label}
      data-testid="episode-topics"
    >
      <span aria-hidden="true">Topik</span>
      {tags.map((tag) => (
        <a
          href={`/tags/${tag}/`}
          class="inline-flex items-center min-h-11 font-semibold text-accent-text hover:text-ink transition"
          data-analytics-event="topic_click"
          data-analytics-props={JSON.stringify({
            tag,
            location: "episode_page",
            videoId,
          })}
        >
          {formatTagLabel(tag)}
        </a>
      ))}
    </nav>
  )
}
