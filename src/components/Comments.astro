---
// Comments.astro - Utterances comment widget component
interface Props {}
// No props needed - utterances uses page URL for issue mapping
---

<section class="mt-12 pt-8 border-t border-surface-border">
  <div class="flex items-center justify-between mb-6">
    <h2 class="text-xl font-bold text-ink">Komentar</h2>
    <a
      href="https://github.com/ngobrolin/landing/discussions"
      target="_blank"
      rel="noopener noreferrer"
      class="text-xs sm:text-sm text-ink-muted hover:text-accent-text transition flex items-center gap-1"
    >
      Buka di GitHub Discussions →
    </a>
  </div>
  <div id="comments-wrapper" class="min-h-[100px] relative">
    <div id="comments-fallback" class="p-4 bg-surface-raised border border-surface-border rounded-lg text-center text-sm text-ink-muted">
      <p class="text-ink font-medium">Memuat komentar dari GitHub Discussions...</p>
      <p class="text-xs text-ink-subtle mt-1">
        Jika komentar tidak muncul karena ekstensi privasi / adblocker, kamu bisa
        <a
          href="https://github.com/ngobrolin/landing/discussions"
          target="_blank"
          rel="noopener noreferrer"
          class="text-accent-text hover:underline"
        >
          berdiskusi langsung di GitHub Discussions
        </a>.
      </p>
    </div>
  </div>
</section>

<script is:inline data-astro-rerun>
  (function initComments() {
    // Load utterances script client-side
    // This script runs after the page loads and injects the comment widget
    const stateKey = "__ngobrolinCommentsState";
    const state = window[stateKey] || { lastUrl: "", listenerAttached: false };
    window[stateKey] = state;

    function loadUtterances(retryCount = 0) {
      // Clear any existing utterances script and widget to ensure fresh load
      const existingScript = document.querySelector('script[src="https://utteranc.es/client.js"]');
      if (existingScript) {
        existingScript.remove();
      }

      // Clear the comments wrapper
      const commentsWrapper = document.getElementById("comments-wrapper");
      if (!commentsWrapper) {
        if (retryCount < 10) {
          requestAnimationFrame(() => loadUtterances(retryCount + 1));
        }
        return;
      }

      const fallback = document.getElementById("comments-fallback");

      // Observer to hide fallback once utterances iframe arrives
      const observer = new MutationObserver(() => {
        const frame = commentsWrapper.querySelector("iframe");
        if (frame) {
          if (fallback) fallback.style.display = "none";
          observer.disconnect();
        }
      });
      observer.observe(commentsWrapper, { childList: true });

      // Create and inject the utterances script
      const utterancesScript = document.createElement("script");
      utterancesScript.src = "https://utteranc.es/client.js";
      utterancesScript.async = true;
      utterancesScript.crossOrigin = "anonymous";

      utterancesScript.onerror = () => {
        observer.disconnect();
        if (fallback) {
          fallback.style.display = "block";
          fallback.innerHTML = `
            <p class="text-ink font-medium">Komentar tidak dapat dimuat otomatis.</p>
            <p class="text-xs text-ink-subtle mt-1">Ekstensi privasi atau adblocker mungkin memblokir widget ini. Silakan <a href="https://github.com/ngobrolin/landing/discussions" target="_blank" rel="noopener noreferrer" class="text-accent-text hover:underline">buka langsung di GitHub Discussions</a>.</p>
          `;
        }
      };

      // Utterances configuration
      utterancesScript.setAttribute("repo", "ngobrolin/landing");
      utterancesScript.setAttribute("issue-term", "title");
      utterancesScript.setAttribute("label", "comment");
      utterancesScript.setAttribute("theme", "preferred-color-scheme");

      commentsWrapper.appendChild(utterancesScript);
    }

    function maybeLoadUtterances() {
      const currentUrl = window.location.href;
      if (state.lastUrl === currentUrl) {
        return;
      }
      state.lastUrl = currentUrl;
      loadUtterances();
    }

    if (!state.listenerAttached) {
      document.addEventListener("astro:page-load", maybeLoadUtterances);
      state.listenerAttached = true;
    }

    const runLoad = () => {
      maybeLoadUtterances();
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", runLoad, { once: true });
    }

    runLoad();
  })();
</script>
