---
// Comments.astro - Utterances comment widget component
interface Props {}
// No props needed - utterances uses page URL for issue mapping
---

<section class="mt-12 pt-8 border-t border-surface-border">
  <h2 class="text-xl font-bold text-ink mb-6">Komentar</h2>
  <div id="comments-wrapper">
    <!-- Utterances will inject the comment widget here -->
  </div>
</section>

<script is:inline data-astro-rerun>
  (function initComments() {
    // Load utterances script client-side
    // This script runs after the page loads and injects the comment widget
    const stateKey = "__ngobrolinCommentsState";
    const state = window[stateKey] || { lastUrl: "", listenerAttached: false };
    window[stateKey] = state;

    function loadUtterances(retryCount = 0) {
      // Clear any existing utterances script and widget to ensure fresh load
      const existingScript = document.querySelector('script[src="https://utteranc.es/client.js"]');
      if (existingScript) {
        existingScript.remove();
      }

      // Clear the comments wrapper
      const commentsWrapper = document.getElementById("comments-wrapper");
      if (!commentsWrapper) {
        if (retryCount < 10) {
          requestAnimationFrame(() => loadUtterances(retryCount + 1));
        }
        return;
      }
      commentsWrapper.innerHTML = '';

      // Create and inject the utterances script
      const utterancesScript = document.createElement("script");
      utterancesScript.src = "https://utteranc.es/client.js";
      utterancesScript.async = true;
      utterancesScript.crossOrigin = "anonymous";

      // Utterances configuration
      utterancesScript.setAttribute("repo", "ngobrolin/landing");
      utterancesScript.setAttribute("issue-term", "title");
      utterancesScript.setAttribute("label", "comment");
      utterancesScript.setAttribute("theme", "preferred-color-scheme");

      commentsWrapper.appendChild(utterancesScript);
    }

    function maybeLoadUtterances() {
      const currentUrl = window.location.href;
      if (state.lastUrl === currentUrl) {
        return;
      }
      state.lastUrl = currentUrl;
      loadUtterances();
    }

    if (!state.listenerAttached) {
      document.addEventListener("astro:page-load", maybeLoadUtterances);
      state.listenerAttached = true;
    }

    const runLoad = () => {
      maybeLoadUtterances();
    };

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", runLoad, { once: true });
    }

    runLoad();
  })();
</script>
