---
import {
  getEpisodes,
  getEpisodesByYear,
  getNewEpisodeSlugs,
} from "../lib/episodes";
import EpisodeCard from "./EpisodeCard.astro";
import type { Episode } from "../lib/episodes";
import { SEARCH_KEYS, buildSearchDocuments } from "../lib/search";

interface Props {
  year?: number;
  episodes?: Episode[];
}

const { year, episodes: providedEpisodes } = Astro.props;
const allEpisodes =
  providedEpisodes ?? (year ? getEpisodesByYear(year) : getEpisodes());
const filteredEpisodes =
  year && providedEpisodes
    ? providedEpisodes.filter(
        (ep) => new Date(ep.publishedAt).getUTCFullYear() === year
      )
    : allEpisodes;

const initialEpisodes = filteredEpisodes;
const newSlugs = getNewEpisodeSlugs();

// The island carries ONLY what Fuse indexes, plus the slug used to map a hit
// back to its already-rendered card. What is searchable is decided in
// src/lib/search.ts, not here.
const searchData = buildSearchDocuments(initialEpisodes);
const searchKeys = SEARCH_KEYS;
---

<div class="mb-8">
  <div class="relative" role="search">
    <input
      type="text"
      id="search-input"
      name="q"
      placeholder="Cari episode..."
      aria-label="Cari episode"
      aria-controls="episodes-grid"
      autocomplete="off"
      class="w-full bg-dark-card border border-dark-border rounded-lg px-4 py-3 pl-12 text-white placeholder-gray-500 focus:outline-none focus:border-primary transition"
    />
    <svg
      class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-500"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>
    <button
      id="clear-search"
      type="button"
      aria-label="Hapus pencarian"
      class="absolute right-4 top-1/2 -translate-y-1/2 text-gray-500 hover:text-white transition hidden"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
  <p
    id="search-results-count"
    class="text-gray-400 text-sm mt-2 hidden"
    role="status"
    aria-live="polite"
  >
  </p>
</div>

<!--
  EpisodeCard renders its title as an h3, so a page whose only other heading is
  the h1 jumped h1 -> h3. This section heading closes the gap without putting
  178 h2s on the page; it is announced but not drawn.
-->
<h2 class="sr-only">Daftar episode</h2>

<div
  id="episodes-grid"
  class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6"
>
  {
    initialEpisodes.map((episode, index) => (
      <EpisodeCard
        title={episode.title}
        description={episode.description}
        publishedAt={episode.publishedAt}
        thumbnail={episode.thumbnail}
        episodeNumber={episode.episodeNumber}
        slug={episode.slug}
        duration={episode.duration}
        isNew={newSlugs.has(episode.slug)}
        loading={index < 4 ? "eager" : "lazy"}
        fetchPriority={index === 0 ? "high" : undefined}
        brief={episode.brief}
      />
    ))
  }
</div>

<div id="no-results" class="hidden text-center py-12">
  <p class="text-gray-400 text-lg">Tidak ada episode yang ditemukan.</p>
  <p class="text-gray-500 text-sm mt-2">Coba kata kunci lain.</p>
</div>

<script
  id="episodes-data"
  type="application/json"
  data-search-keys={JSON.stringify(searchKeys)}
  set:html={JSON.stringify(searchData).replace(/</g, "\\u003c")}
/>

<script>
  import Fuse from "fuse.js";
  import { isShortQuery, searchShortQuery } from "../lib/search";
  import type { SearchDocument } from "../lib/search";

  // Search filters the cards Astro already rendered rather than re-rendering
  // them from a JS template. The old template was a second, drifting copy of
  // EpisodeCard: it hardcoded #6366f1 instead of the palette's #5c5fed, built
  // unoptimised image markup that bypassed Astro's asset pipeline, and dropped
  // the offline indicator. Toggling visibility keeps one source of truth.
  //
  // Relevance order moves the actual grid nodes. CSS `order` would rank them
  // for a sighted visitor only, leaving keyboard and screen-reader users
  // traversing publication order (WCAG 2.4.3 Focus Order, 1.3.2 Meaningful
  // Sequence).
  function initSearch() {
    const input = document.getElementById(
      "search-input"
    ) as HTMLInputElement | null;
    if (!input) return;

    // Fresh DOM after a client-side navigation won't carry this flag.
    if (input.dataset.searchInitialized === "true") return;

    const grid = document.getElementById("episodes-grid");
    const noResults = document.getElementById("no-results");
    const resultsCount = document.getElementById("search-results-count");
    const clearBtn = document.getElementById("clear-search");
    const dataEl = document.getElementById("episodes-data");
    if (!grid || !noResults || !resultsCount || !clearBtn || !dataEl) return;

    let searchData: SearchDocument[] = [];
    try {
      searchData = JSON.parse(dataEl.textContent || "[]");
    } catch {
      return;
    }

    // Field list comes from the island, which comes from SEARCH_KEYS. Adding a
    // searchable field is a change in src/lib/search.ts alone.
    let keys: string[] = ["title", "description", "brief"];
    try {
      const declared = JSON.parse(dataEl.dataset.searchKeys || "[]");
      if (Array.isArray(declared) && declared.length > 0) keys = declared;
    } catch {
      /* fall back to the defaults above */
    }

    // Tuned against the real corpus, not guessed. Fuse only scores near the
    // start of a field by default (location 0, distance 100), so "keychron" at
    // character 64 of a key-points string was unreachable. ignoreLocation fixes
    // that but makes threshold 0.4 useless - measured over all 178 episodes it
    // returned 94/178 for "astro" and 164/178 for "karir". At 0.2 the same
    // queries return 23 and 8, with the true matches ranked first.
    const fuse = new Fuse(searchData, {
      keys,
      threshold: 0.2,
      ignoreLocation: true,
      minMatchCharLength: 3,
      includeScore: true,
    });

    // Captured once, because the DOM stops holding publication order the
    // moment the first query reorders it.
    const originalOrder = Array.from(
      grid.querySelectorAll<HTMLElement>("[data-episode-slug]")
    );
    const cards = new Map<string, HTMLElement>();
    for (const card of originalOrder) {
      cards.set(card.dataset.episodeSlug || "", card);
    }

    // Only mark initialised once everything above has succeeded. Setting the
    // flag before the risky work is what turned the previous Fuse ordering bug
    // into a permanent failure instead of a recoverable one.
    input.dataset.searchInitialized = "true";

    function layout(ordered: HTMLElement[], hiddenCards: Set<HTMLElement>) {
      const fragment = document.createDocumentFragment();
      for (const card of ordered) {
        card.hidden = hiddenCards.has(card);
        fragment.appendChild(card);
      }
      grid!.appendChild(fragment);
    }

    function showAll() {
      layout(originalOrder, new Set());
      grid!.hidden = false;
      noResults!.classList.add("hidden");
      resultsCount!.classList.add("hidden");
    }

    function handleSearch() {
      const query = input!.value.trim();
      clearBtn!.classList.toggle("hidden", !query);

      if (!query) {
        showAll();
        return;
      }

      // Queries too short for fuzzy matching get an exact, word-boundary pass
      // over titles and key points instead. src/lib/search.ts owns both rules.
      const hitSlugs = isShortQuery(query)
        ? searchShortQuery(query, searchData).map((doc) => doc.slug)
        : fuse.search(query).map((hit) => hit.item.slug);

      const ranked: HTMLElement[] = [];
      const seen = new Set<HTMLElement>();
      for (const slug of hitSlugs) {
        const card = cards.get(slug);
        if (card && !seen.has(card)) {
          seen.add(card);
          ranked.push(card);
        }
      }

      const misses = originalOrder.filter((card) => !seen.has(card));
      layout([...ranked, ...misses], new Set(misses));

      const found = ranked.length;
      grid!.hidden = found === 0;
      noResults!.classList.toggle("hidden", found > 0);

      if (found > 0) {
        resultsCount!.textContent = `${found} episode ditemukan`;
        resultsCount!.classList.remove("hidden");
      } else {
        resultsCount!.classList.add("hidden");
      }
    }

    input.addEventListener("input", handleSearch);

    clearBtn.addEventListener("click", () => {
      input!.value = "";
      handleSearch();
      input!.focus();
    });

    // Prefill from the querystring so results are shareable, and because
    // Layout.astro advertises /episodes/?q={search_term_string} to search
    // engines as a schema.org SearchAction.
    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get("q") || params.get("query");
    if (initialQuery) input.value = initialQuery;

    // Run once against whatever is already in the field. That covers the
    // querystring above, and also the visitor who starts typing before this
    // module has finished loading — the input is focusable the moment the
    // markup lands, but their `input` events fire into nothing until the
    // listener above exists, and no further event would ever replay them.
    // Without this, arriving via a client-side navigation and typing quickly
    // leaves the query sitting in the box with the full archive below it.
    if (input.value.trim()) handleSearch();
  }

  // ClientRouter is site-wide, so this has to survive client-side navigation.
  // `data-astro-rerun` is not available to us: this script has an import, so
  // Astro bundles it as a module and that attribute only applies to inline
  // scripts. Three hooks, each earned by measurement rather than superstition:
  //
  //  1. Call it now. On a first load the module is deferred until after
  //     parsing, so the DOM is ready. This also covers arriving at a page
  //     whose module finishes loading *after* astro:page-load has fired.
  //  2. astro:after-swap. Navigating / -> /episodes was measured to fire
  //     before-preparation, after-preparation, before-swap and after-swap,
  //     but NOT page-load, because this module had never loaded on / and so
  //     was still arriving when the navigation completed. after-swap is the
  //     hook that actually fires on that path.
  //  3. astro:page-load. The canonical hook, and the one that fires when the
  //     module was already loaded by a previous page.
  //
  // initSearch is idempotent (it guards on the input element, and the swapped
  // DOM carries a fresh input), so overlapping hooks cannot double-bind.
  initSearch();
  document.addEventListener("astro:after-swap", initSearch);
  document.addEventListener("astro:page-load", initSearch);
</script>
