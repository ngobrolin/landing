---
import {
  getEpisodes,
  getEpisodesByYear,
  getNewEpisodeSlugs,
} from "../lib/episodes";
import EpisodeCard from "./EpisodeCard.astro";
import type { Episode } from "../lib/episodes";
import { SEARCH_KEYS, SEARCH_INDEX_PATH } from "../lib/search";

interface Props {
  year?: number;
  episodes?: Episode[];
}

const { year, episodes: providedEpisodes } = Astro.props;
const allEpisodes =
  providedEpisodes ?? (year ? getEpisodesByYear(year) : getEpisodes());
const filteredEpisodes =
  year && providedEpisodes
    ? providedEpisodes.filter(
        (ep) => new Date(ep.publishedAt).getUTCFullYear() === year
      )
    : allEpisodes;

const initialEpisodes = filteredEpisodes;
const newSlugs = getNewEpisodeSlugs();

// No index is inlined here. The page advertises where to fetch one and which
// fields it declares; what is searchable is decided in src/lib/search.ts, and
// the documents themselves come from src/pages/search-index.json.ts.
const searchKeys = SEARCH_KEYS;
---

<div class="mb-8">
  <div class="relative" role="search">
    <input
      type="text"
      id="search-input"
      name="q"
      placeholder="Cari episode..."
      aria-label="Cari episode"
      aria-controls="episodes-grid"
      autocomplete="off"
      class="w-full bg-surface-raised border border-surface-border-strong rounded-lg px-4 py-3 pl-12 text-ink placeholder-ink-subtle focus:border-accent-text transition"
    />
    <svg
      class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-ink-subtle"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>
    <button
      id="clear-search"
      type="button"
      aria-label="Hapus pencarian"
      class="absolute right-4 top-1/2 -translate-y-1/2 text-ink-subtle hover:text-ink transition hidden"
    >
      <svg
        class="w-5 h-5"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>
  <p
    id="search-results-count"
    class="text-ink-muted text-sm mt-2 hidden"
    role="status"
    aria-live="polite"
  >
  </p>
</div>

<!--
  EpisodeCard renders its title as an h3, so a page whose only other heading is
  the h1 jumped h1 -> h3. This section heading closes the gap without putting
  an h2 on every card; it is announced but not drawn.
-->
<h2 class="sr-only">Daftar episode</h2>

<div
  id="episodes-grid"
  class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6"
>
  {
    initialEpisodes.map((episode, index) => (
      <EpisodeCard
        title={episode.title}
        description={episode.description}
        publishedAt={episode.publishedAt}
        thumbnail={episode.thumbnail}
        episodeNumber={episode.episodeNumber}
        slug={episode.slug}
        duration={episode.duration}
        isNew={newSlugs.has(episode.slug)}
        loading={index < 4 ? "eager" : "lazy"}
        fetchPriority={index === 0 ? "high" : undefined}
        brief={episode.brief}
      />
    ))
  }
</div>

<div id="no-results" class="hidden text-center py-12">
  <p class="text-ink-muted text-lg">Tidak ada episode yang ditemukan.</p>
  <p class="text-ink-subtle text-sm mt-2">Coba kata kunci lain.</p>
</div>

<div
  id="search-config"
  hidden
  data-search-keys={JSON.stringify(searchKeys)}
  data-search-index={SEARCH_INDEX_PATH}
>
</div>

<script>
  import Fuse from "fuse.js";
  import {
    SEARCH_INDEX_PATH,
    isShortQuery,
    searchShortQuery,
  } from "../lib/search";
  import type { SearchDocument } from "../lib/search";

  // Shown in the result-count element while the index is on its way, and after
  // it fails. This branch exists because search was once silently dead: the
  // input must never sit there doing nothing, so every state says something.
  const PENDING_NOTE = "Menyiapkan pencarian...";
  const FALLBACK_NOTE = " (judul saja - indeks pencarian gagal dimuat)";

  // Module-level, so navigating between /episodes and a year page reuses the
  // documents already in memory instead of fetching them again.
  let indexPromise: Promise<SearchDocument[]> | null = null;

  function loadIndex(url: string): Promise<SearchDocument[]> {
    if (!indexPromise) {
      indexPromise = fetch(url)
        .then((response) => {
          if (!response.ok) throw new Error(`search index HTTP ${response.status}`);
          return response.json();
        })
        .then((data) => {
          if (!Array.isArray(data)) throw new Error("search index is not a list");
          return data as SearchDocument[];
        })
        .catch((error) => {
          // Dropped rather than cached, so a later page can try again. A
          // per-page flag keeps a broken network from being retried on every
          // keystroke in the meantime.
          indexPromise = null;
          throw error;
        });
    }
    return indexPromise;
  }

  // Search filters the cards Astro already rendered rather than re-rendering
  // them from a JS template. The old template was a second, drifting copy of
  // EpisodeCard: it hardcoded its own accent instead of using the palette, built
  // unoptimised image markup that bypassed Astro's asset pipeline, and dropped
  // the offline indicator. Toggling visibility keeps one source of truth.
  //
  // Relevance order moves the actual grid nodes. CSS `order` would rank them
  // for a sighted visitor only, leaving keyboard and screen-reader users
  // traversing publication order (WCAG 2.4.3 Focus Order, 1.3.2 Meaningful
  // Sequence).
  function initSearch() {
    const input = document.getElementById(
      "search-input"
    ) as HTMLInputElement | null;
    if (!input) return;

    // Fresh DOM after a client-side navigation won't carry this flag.
    if (input.dataset.searchInitialized === "true") return;

    const grid = document.getElementById("episodes-grid");
    const noResults = document.getElementById("no-results");
    const resultsCount = document.getElementById("search-results-count");
    const clearBtn = document.getElementById("clear-search");
    const config = document.getElementById("search-config");
    if (!grid || !noResults || !resultsCount || !clearBtn || !config) return;

    const indexUrl = config.dataset.searchIndex || SEARCH_INDEX_PATH;

    // Field list comes from the page, which comes from SEARCH_KEYS. Adding a
    // searchable field is a change in src/lib/search.ts alone.
    let keys: string[] = ["title", "description", "brief"];
    try {
      const declared = JSON.parse(config.dataset.searchKeys || "[]");
      if (Array.isArray(declared) && declared.length > 0) keys = declared;
    } catch {
      /* fall back to the defaults above */
    }

    // Captured once, because the DOM stops holding publication order the
    // moment the first query reorders it.
    const originalOrder = Array.from(
      grid.querySelectorAll<HTMLElement>("[data-episode-slug]")
    );
    const cards = new Map<string, HTMLElement>();
    // Titles as rendered. They are the only searchable text guaranteed to be
    // on the page already, so they are what the degraded path matches against
    // when the index cannot be fetched.
    const cardTitles: { slug: string; title: string; keyPoints: string }[] = [];
    for (const card of originalOrder) {
      const slug = card.dataset.episodeSlug || "";
      cards.set(slug, card);
      cardTitles.push({
        slug,
        title: card.querySelector("h3")?.textContent?.trim() || "",
        keyPoints: "",
      });
    }

    // Only mark initialised once everything above has succeeded. Setting the
    // flag before the risky work is what turned the previous Fuse ordering bug
    // into a permanent failure instead of a recoverable one.
    input.dataset.searchInitialized = "true";

    let searchData: SearchDocument[] | null = null;
    let fuse: Fuse<SearchDocument> | null = null;
    let indexFailed = false;
    let requested = false;

    function requestIndex() {
      if (requested || searchData || indexFailed) return;
      requested = true;

      loadIndex(indexUrl).then(
        (documents) => {
          // One file serves the whole archive; a year page keeps only the
          // documents whose card it actually rendered.
          searchData = documents.filter((doc) => cards.has(doc.slug));

          // Tuned against the real corpus, not guessed. Fuse only scores near
          // the start of a field by default (location 0, distance 100), so
          // "keychron" at character 64 of a key-points string was unreachable.
          // ignoreLocation fixes that but makes threshold 0.4 useless -
          // measured over all 178 episodes it returned 94/178 for "astro" and
          // 164/178 for "karir". At 0.2 the same queries return 23 and 8, with
          // the true matches ranked first.
          fuse = new Fuse(searchData, {
            keys,
            threshold: 0.2,
            ignoreLocation: true,
            minMatchCharLength: 3,
            includeScore: true,
          });

          // Apply whatever was typed while the fetch was in flight. Without
          // this, a slow index leaves the query sitting in the box above the
          // unfiltered archive - the same class of bug as the module-load race
          // handled at the bottom of this file.
          if (input!.value.trim()) handleSearch();
        },
        () => {
          indexFailed = true;
          if (input!.value.trim()) handleSearch();
        }
      );
    }

    function layout(ordered: HTMLElement[], hiddenCards: Set<HTMLElement>) {
      const fragment = document.createDocumentFragment();
      for (const card of ordered) {
        card.hidden = hiddenCards.has(card);
        fragment.appendChild(card);
      }
      grid!.appendChild(fragment);
    }

    function showAll() {
      layout(originalOrder, new Set());
      grid!.hidden = false;
      noResults!.classList.add("hidden");
      resultsCount!.classList.add("hidden");
    }

    function announce(text: string) {
      resultsCount!.textContent = text;
      resultsCount!.classList.remove("hidden");
    }

    function render(hitSlugs: string[], note: string) {
      const ranked: HTMLElement[] = [];
      const seen = new Set<HTMLElement>();
      for (const slug of hitSlugs) {
        const card = cards.get(slug);
        if (card && !seen.has(card)) {
          seen.add(card);
          ranked.push(card);
        }
      }

      const misses = originalOrder.filter((card) => !seen.has(card));
      layout([...ranked, ...misses], new Set(misses));

      const found = ranked.length;
      grid!.hidden = found === 0;
      noResults!.classList.toggle("hidden", found > 0);

      if (found > 0) {
        announce(`${found} episode ditemukan${note}`);
      } else if (note) {
        // A degraded run still has to say why it found nothing, otherwise the
        // empty state reads as "no such episode" when it means "no index".
        announce(`0 episode ditemukan${note}`);
      } else {
        resultsCount!.classList.add("hidden");
      }
    }

    /**
     * Degraded search over the titles already on the page.
     *
     * Reached only when the index cannot be fetched or cannot be parsed. Short
     * queries keep the word-boundary rule from src/lib/search.ts, because "ai"
     * inside "mulai" is just as wrong here as it is in the full index.
     */
    function searchTitles(query: string): string[] {
      if (isShortQuery(query)) {
        return searchShortQuery(query, cardTitles).map((doc) => doc.slug);
      }
      const needle = query.toLowerCase();
      return cardTitles
        .filter((doc) => doc.title.toLowerCase().includes(needle))
        .map((doc) => doc.slug);
    }

    function handleSearch() {
      const query = input!.value.trim();
      clearBtn!.classList.toggle("hidden", !query);

      if (!query) {
        showAll();
        return;
      }

      requestIndex();

      if (searchData && fuse) {
        // Queries too short for fuzzy matching get an exact, word-boundary
        // pass over titles and key points. src/lib/search.ts owns both rules.
        const hitSlugs = isShortQuery(query)
          ? searchShortQuery(query, searchData).map((doc) => doc.slug)
          : fuse.search(query).map((hit) => hit.item.slug);
        render(hitSlugs, "");
        return;
      }

      if (indexFailed) {
        render(searchTitles(query), FALLBACK_NOTE);
        return;
      }

      // In flight. The archive stays on screen rather than emptying or
      // freezing, and the query is re-applied the moment the index lands.
      grid!.hidden = false;
      noResults!.classList.add("hidden");
      announce(PENDING_NOTE);
    }

    // Debounced, because a keystroke is not cheap: ignoreLocation makes Fuse
    // scan each document in full, and every pass re-appends every card.
    // Trailing edge, so the last keystroke always runs.
    let debounceTimer: number | undefined;
    input.addEventListener("input", () => {
      // Undebounced on purpose - the fetch should start on the first keystroke
      // rather than 120ms after the last one.
      requestIndex();
      window.clearTimeout(debounceTimer);
      debounceTimer = window.setTimeout(handleSearch, 120);
    });

    // Focusing the field is a strong enough signal to start fetching.
    input.addEventListener("focus", requestIndex);

    clearBtn.addEventListener("click", () => {
      window.clearTimeout(debounceTimer);
      input!.value = "";
      handleSearch();
      input!.focus();
    });

    // Prefill from the querystring so results are shareable, and because
    // Layout.astro advertises /episodes/?q={search_term_string} to search
    // engines as a schema.org SearchAction.
    const params = new URLSearchParams(window.location.search);
    const initialQuery = params.get("q") || params.get("query");
    if (initialQuery) input.value = initialQuery;

    // Run once against whatever is already in the field. That covers the
    // querystring above, and also the visitor who starts typing before this
    // module has finished loading — the input is focusable the moment the
    // markup lands, but their `input` events fire into nothing until the
    // listener above exists, and no further event would ever replay them.
    // Without this, arriving via a client-side navigation and typing quickly
    // leaves the query sitting in the box with the full archive below it.
    if (input.value.trim()) handleSearch();
  }

  // ClientRouter is site-wide, so this has to survive client-side navigation.
  // `data-astro-rerun` is not available to us: this script has an import, so
  // Astro bundles it as a module and that attribute only applies to inline
  // scripts. Three hooks, each earned by measurement rather than superstition:
  //
  //  1. Call it now. On a first load the module is deferred until after
  //     parsing, so the DOM is ready. This also covers arriving at a page
  //     whose module finishes loading *after* astro:page-load has fired.
  //  2. astro:after-swap. Navigating / -> /episodes was measured to fire
  //     before-preparation, after-preparation, before-swap and after-swap,
  //     but NOT page-load, because this module had never loaded on / and so
  //     was still arriving when the navigation completed. after-swap is the
  //     hook that actually fires on that path.
  //  3. astro:page-load. The canonical hook, and the one that fires when the
  //     module was already loaded by a previous page.
  //
  // initSearch is idempotent (it guards on the input element, and the swapped
  // DOM carries a fresh input), so overlapping hooks cannot double-bind.
  initSearch();
  document.addEventListener("astro:after-swap", initSearch);
  document.addEventListener("astro:page-load", initSearch);
</script>
