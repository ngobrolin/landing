---
import { getSummary } from "../lib/seo";
import {
    TERM_BOUNDARY,
    dropRepeatedCues,
    groupByMinute,
    offeredTerms,
    termCandidates,
    timeMarks,
    type Cue,
} from "../lib/transcript-view";

interface Props {
    videoId: string;
}

const { videoId } = Astro.props;

// `source` records provenance and is absent from the whisper-generated
// transcripts written before it existed, so it must stay optional.
let transcript: {
    segments: Cue[];
    fullText: string;
    source?: string;
} | null = null;

try {
    const transcripts = import.meta.glob("../data/transcripts/*.json", {
        eager: true,
    });
    const key = `../data/transcripts/${videoId}.json`;
    if (transcripts[key]) {
        transcript = transcripts[key] as typeof transcript;
    }
} catch {
    transcript = null;
}

const editUrl = `https://github.com/ngobrolin/landing/edit/main/src/data/transcripts/${videoId}.json`;

const isAutoGenerated = transcript?.source === "youtube-auto";

const cues = dropRepeatedCues(transcript?.segments ?? []);
const minutes = groupByMinute(cues);
const marks = timeMarks(cues.length > 0 ? cues[cues.length - 1].end : 0);

const summary = getSummary(videoId);
const terms = offeredTerms(
    cues,
    termCandidates({ keyPoints: summary?.keyPoints, brief: summary?.brief }),
);
// Two terms read as a leftover, not as a way in.
const showTerms = terms.length >= 3;

function formatTime(seconds: number): string {
    const h = Math.floor(seconds / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    const s = Math.floor(seconds % 60);

    if (h > 0) {
        return `${h}:${m.toString().padStart(2, "0")}:${s.toString().padStart(2, "0")}`;
    }
    return `${m}:${s.toString().padStart(2, "0")}`;
}

const stampClass =
    "timestamp-seek-btn font-mono text-sm tabular-nums text-accent-text hover:text-ink hover:underline rounded cursor-pointer select-none transition";
const linkClass = "font-semibold text-accent-text hover:text-ink transition cursor-pointer";
---

{
    transcript && (
        <section
            id="transkrip"
            aria-labelledby="transcript-heading"
            data-testid="transcript"
            data-transcript-container
            data-term-boundary={TERM_BOUNDARY}
        >
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 mb-5">
                <h2 id="transcript-heading" class="display text-2xl md:text-3xl leading-none text-ink">
                    Cari momen di episode ini
                </h2>
                {isAutoGenerated && (
                    <span
                        data-testid="transcript-auto-badge"
                        class="text-xs font-normal text-ink-subtle border border-surface-border rounded px-1.5 py-0.5"
                        title="Transkrip ini diambil dari subtitle otomatis YouTube dan belum dikoreksi."
                    >
                        otomatis
                    </span>
                )}
                <a
                    href={editUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="ml-auto inline-flex items-center gap-1.5 min-h-11 text-sm text-ink-muted hover:text-accent-text transition"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                        />
                    </svg>
                    Bantu Koreksi
                </a>
            </div>

            <div class="relative max-w-2xl">
                <input
                    type="search"
                    id="transcript-search-input"
                    placeholder="Cari kata dalam transkrip..."
                    class="w-full h-13 pl-4 pr-11 bg-surface border border-surface-border-strong rounded-md text-ink placeholder-ink-subtle focus:border-accent-text transition"
                    aria-label="Cari kata dalam transkrip episode"
                />
                <button
                    type="button"
                    id="transcript-search-clear"
                    hidden
                    class="absolute right-1 top-1/2 -translate-y-1/2 size-11 inline-flex items-center justify-center text-ink-muted hover:text-ink rounded transition"
                    aria-label="Hapus kata kunci pencarian"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M6 6l12 12M18 6L6 18" />
                    </svg>
                </button>
            </div>

            <div class="mt-4 flex flex-col text-ink-subtle tabular-nums">
                {showTerms && (
                    <p class="flex flex-wrap items-baseline gap-x-5" data-testid="transcript-terms">
                        <span>Sering disebut</span>
                        {terms.map(({ term, count }) => (
                            <span class="whitespace-nowrap">
                                <button type="button" class:list={[linkClass, "inline-flex items-center min-h-11"]} data-term={term}>{term}</button>{" "}
                                <span data-term-count>{count}</span>
                            </span>
                        ))}
                    </p>
                )}
                <p class="flex flex-wrap items-baseline gap-x-4" data-transcript-jump>
                    <span class="mr-1">Lompat ke</span>
                    {marks.map((mark) => (
                        <button
                            type="button"
                            class:list={[stampClass, "inline-flex items-center min-h-11"]}
                            data-seek-time={mark}
                            aria-label={`Putar dari ${formatTime(mark)}`}
                        >
                            {formatTime(mark)}
                        </button>
                    ))}
                </p>
            </div>

            <p id="transcript-search-status" class="hidden mt-4 text-sm text-ink-muted" aria-live="polite"></p>
            <div class="mt-3 flex flex-col gap-3" data-transcript-results></div>

            <details class="mt-4" id="transcript-details">
                <summary class:list={[linkClass, "inline-flex items-center min-h-11"]}>
                    Lihat transkrip lengkap
                </summary>
                <div class="mt-3 flex flex-col gap-4">
                    {minutes.map((minute) => (
                        <p class="max-w-[68ch] text-ink-body leading-relaxed">
                            <button
                                type="button"
                                class:list={[stampClass, "mr-2.5"]}
                                data-seek-time={minute.start}
                                aria-label={`Putar dari ${formatTime(minute.start)}`}
                            >
                                {formatTime(minute.start)}
                            </button>
                            {minute.cues.map((cue) => (
                                <span data-t={cue.start}>{`${cue.text} `}</span>
                            ))}
                        </p>
                    ))}
                </div>
            </details>
        </section>
    )
}

<script is:inline data-astro-rerun>
  (function initTranscriptInteractions() {
    const container = document.querySelector("[data-transcript-container]");
    if (!container || container.hasAttribute("data-transcript-initialized")) return;

    const searchInput = document.getElementById("transcript-search-input");
    const clearBtn = document.getElementById("transcript-search-clear");
    const statusText = document.getElementById("transcript-search-status");
    const results = container.querySelector("[data-transcript-results]");
    const jump = container.querySelector("[data-transcript-jump]");
    const stampClass = container.querySelector("#transcript-details .timestamp-seek-btn")?.className || "timestamp-seek-btn";
    const boundary = container.getAttribute("data-term-boundary");
    const cues = Array.from(container.querySelectorAll("#transcript-details [data-t]"), (el) => ({
      start: Number(el.getAttribute("data-t")),
      text: el.textContent.trim(),
    }));
    const MAX_RESULTS = 30;

    function clock(seconds) {
      const h = Math.floor(seconds / 3600);
      const m = Math.floor((seconds % 3600) / 60);
      const s = String(Math.floor(seconds % 60)).padStart(2, "0");
      return h > 0 ? `${h}:${String(m).padStart(2, "0")}:${s}` : `${m}:${s}`;
    }

    container.addEventListener("click", (e) => {
      const target = e.target;
      if (!(target instanceof Element)) return;

      const term = target.closest("[data-term]");
      if (term && searchInput) {
        searchInput.value = term.getAttribute("data-term");
        performSearch();
        return;
      }

      const btn = target.closest(".timestamp-seek-btn");
      if (!btn) return;
      const seconds = parseFloat(btn.getAttribute("data-seek-time") || "");
      if (isNaN(seconds)) return;

      // With less than half the player on screen, an episode that has audio
      // plays it in the pinned bar and the reader keeps their place. Otherwise
      // the player on the page takes the seek and scrolls itself into view.
      const media = document.querySelector("[data-episode-media][data-media-initialized]");
      const audioPanel = media && media.querySelector("[data-audio-panel]");
      if (audioPanel) {
        const rect = media.getBoundingClientRect();
        const visible = Math.min(rect.bottom, window.innerHeight) - Math.max(rect.top, 0);
        if (visible < rect.height / 2) {
          // Swapping video for audio changes the player's height. Not every
          // browser anchors the scroll, so put the clicked line back itself.
          const before = btn.getBoundingClientRect().top;
          audioPanel.dispatchEvent(new CustomEvent("ngobrolin:seek-pinned", { detail: { seconds } }));
          const moved = btn.getBoundingClientRect().top - before;
          if (moved !== 0) window.scrollBy(0, moved);
          return;
        }
      }

      window.dispatchEvent(
        new CustomEvent("ngobrolin:seek-video", {
          detail: { seconds },
        })
      );
    });

    // Mirrors findMentions() in src/lib/transcript-view.ts, so a term's count
    // is the number of results its click returns.
    function findMentions(pattern) {
      const found = [];
      let previous = -2;
      cues.forEach((cue, index) => {
        if (!pattern.test(cue.text)) return;
        if (index !== previous + 1) found.push(index);
        previous = index;
      });
      return found;
    }

    function resultRow(index, query) {
      const row = document.createElement("p");
      row.className = "max-w-[68ch] text-ink-body leading-relaxed";
      row.setAttribute("data-transcript-result", "");

      const stamp = document.createElement("button");
      stamp.type = "button";
      stamp.className = stampClass;
      stamp.setAttribute("data-seek-time", String(cues[index].start));
      stamp.setAttribute("aria-label", `Putar dari ${clock(cues[index].start)}`);
      stamp.textContent = clock(cues[index].start);
      row.append(stamp);

      // One caption line is too short to read alone, so it comes with its neighbours.
      const context = [cues[index - 1], cues[index], cues[index + 1]].filter(Boolean).map((cue) => cue.text).join(" ");
      const marker = new RegExp(boundary + "(" + query + ")", "giu");
      let cursor = 0;
      for (const match of context.matchAll(marker)) {
        const at = match.index + match[1].length;
        row.append(context.slice(cursor, at));
        const mark = document.createElement("mark");
        mark.className = "rounded-sm bg-accent/20 px-0.5 text-ink";
        mark.textContent = match[2];
        row.append(mark);
        cursor = at + match[2].length;
      }
      row.append(context.slice(cursor));
      return row;
    }

    function performSearch() {
      const raw = searchInput.value.trim();
      results.replaceChildren();

      if (raw.length < 2) {
        if (clearBtn) clearBtn.hidden = raw.length === 0;
        statusText.classList.add("hidden");
        statusText.textContent = "";
        if (jump) jump.hidden = false;
        return;
      }

      if (clearBtn) clearBtn.hidden = false;
      if (jump) jump.hidden = true;

      const query = raw.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
      const found = findMentions(new RegExp(boundary + query, "iu"));
      found.slice(0, MAX_RESULTS).forEach((index) => results.append(resultRow(index, query)));

      statusText.classList.remove("hidden");
      if (found.length === 0) {
        statusText.textContent = `Tidak ditemukan segmen dengan kata "${raw}".`;
      } else {
        statusText.textContent =
          `Ditemukan ${found.length} segmen yang cocok.` +
          (found.length > MAX_RESULTS ? ` Menampilkan ${MAX_RESULTS} pertama.` : "");
      }
    }

    if (searchInput && statusText && results && boundary) {
      searchInput.addEventListener("input", performSearch);

      if (clearBtn) {
        clearBtn.addEventListener("click", () => {
          searchInput.value = "";
          performSearch();
          searchInput.focus();
        });
      }
    }

    container.setAttribute("data-transcript-initialized", "true");
  })();
</script>
