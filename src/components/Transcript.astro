---
interface Segment {
    start: number;
    end: number;
    text: string;
}

interface Props {
    videoId: string;
    previewCount?: number;
}

const { videoId, previewCount = 30 } = Astro.props;

// `source` records provenance and is absent from the whisper-generated
// transcripts written before it existed, so it must stay optional.
let transcript: {
    segments: Segment[];
    fullText: string;
    source?: string;
} | null = null;

try {
    const transcripts = import.meta.glob("../data/transcripts/*.json", {
        eager: true,
    });
    const key = `../data/transcripts/${videoId}.json`;
    if (transcripts[key]) {
        transcript = transcripts[key] as typeof transcript;
    }
} catch {
    transcript = null;
}

const editUrl = `https://github.com/ngobrolin/landing/edit/main/src/data/transcripts/${videoId}.json`;

const isAutoGenerated = transcript?.source === "youtube-auto";

const previewSegments = transcript?.segments.slice(0, previewCount) ?? [];
const remainingSegments = transcript?.segments.slice(previewCount) ?? [];

function formatTime(seconds: number): string {
    const h = Math.floor(seconds / 3600);
    const m = Math.floor((seconds % 3600) / 60);
    const s = Math.floor(seconds % 60);

    if (h > 0) {
        return `${h}:${m.toString().padStart(2, "0")}:${s.toString().padStart(2, "0")}`;
    }
    return `${m}:${s.toString().padStart(2, "0")}`;
}
---

{
    transcript && (
        <div class="mt-8 border-t border-surface-border pt-8" data-testid="transcript">
            <div class="flex items-center gap-2 text-ink font-semibold text-lg mb-4">
                <span>Transkrip</span>
                {isAutoGenerated && (
                    <span
                        data-testid="transcript-auto-badge"
                        class="text-xs font-normal text-ink-subtle border border-surface-border rounded px-1.5 py-0.5"
                        title="Transkrip ini diambil dari subtitle otomatis YouTube dan belum dikoreksi."
                    >
                        otomatis
                    </span>
                )}
                <a
                    href={editUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="ml-auto flex items-center gap-1.5 text-sm text-ink-muted hover:text-accent-text transition font-normal"
                >
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                        />
                    </svg>
                    Bantu Koreksi
                </a>
            </div>

            <div class="bg-surface-raised border border-surface-border rounded-lg p-4" data-transcript-container>
                <!-- Inline search / filter -->
                <div class="mb-4">
                    <div class="relative">
                        <input
                            type="search"
                            id="transcript-search-input"
                            placeholder="Cari kata dalam transkrip..."
                            class="w-full bg-surface border border-surface-border text-ink text-sm rounded-lg pl-9 pr-8 py-2 placeholder:text-ink-subtle focus:border-accent-text focus:outline-none transition"
                            aria-label="Cari kata dalam transkrip episode"
                        />
                        <svg
                            class="w-4 h-4 text-ink-muted absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"
                            fill="none"
                            stroke="currentColor"
                            viewBox="0 0 24 24"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                            />
                        </svg>
                        <button
                            type="button"
                            id="transcript-search-clear"
                            class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-ink-muted hover:text-ink p-1 rounded transition text-xs"
                            aria-label="Hapus kata kunci pencarian"
                        >
                            ✕
                        </button>
                    </div>
                    <p
                        id="transcript-search-status"
                        class="text-xs text-ink-muted mt-2 hidden"
                        aria-live="polite"
                    ></p>
                </div>

                <div class="space-y-3" id="transcript-preview-list">
                    {previewSegments.map((segment) => (
                        <p class="transcript-segment text-ink-body leading-relaxed" data-segment-text={segment.text.toLowerCase()}>
                            <button
                                type="button"
                                class="timestamp-seek-btn text-accent hover:text-accent-text hover:underline focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-none rounded text-sm font-mono mr-2 select-none cursor-pointer transition inline-flex items-center"
                                data-seek-time={segment.start}
                                title={`Putar video pada ${formatTime(segment.start)}`}
                                aria-label={`Putar video pada ${formatTime(segment.start)}`}
                            >
                                {formatTime(segment.start)}
                            </button>
                            <span>{segment.text}</span>
                        </p>
                    ))}
                </div>

                {remainingSegments.length > 0 && (
                    <details class="mt-3 group" id="transcript-details">
                        <summary class="cursor-pointer text-accent-text hover:text-accent transition text-sm font-medium">
                            Lihat transkrip lengkap ({remainingSegments.length} segmen lagi)
                        </summary>
                        <div class="space-y-3 mt-3" id="transcript-remaining-list">
                            {remainingSegments.map((segment) => (
                                <p class="transcript-segment text-ink-body leading-relaxed" data-segment-text={segment.text.toLowerCase()}>
                                    <button
                                        type="button"
                                        class="timestamp-seek-btn text-accent hover:text-accent-text hover:underline focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-none rounded text-sm font-mono mr-2 select-none cursor-pointer transition inline-flex items-center"
                                        data-seek-time={segment.start}
                                        title={`Putar video pada ${formatTime(segment.start)}`}
                                        aria-label={`Putar video pada ${formatTime(segment.start)}`}
                                    >
                                        {formatTime(segment.start)}
                                    </button>
                                    <span>{segment.text}</span>
                                </p>
                            ))}
                        </div>
                    </details>
                )}
            </div>
        </div>
    )
}

<script is:inline data-astro-rerun>
  (function initTranscriptInteractions() {
    const container = document.querySelector("[data-transcript-container]");
    if (!container || container.hasAttribute("data-transcript-initialized")) return;

    const searchInput = document.getElementById("transcript-search-input");
    const clearBtn = document.getElementById("transcript-search-clear");
    const statusText = document.getElementById("transcript-search-status");
    const details = document.getElementById("transcript-details");
    const allSegments = container.querySelectorAll(".transcript-segment");

    // Seek buttons listener
    container.addEventListener("click", (e) => {
      const target = e.target;
      if (!(target instanceof HTMLElement)) return;
      const btn = target.closest(".timestamp-seek-btn");
      if (!btn) return;

      const timeAttr = btn.getAttribute("data-seek-time");
      if (!timeAttr) return;
      const seconds = parseFloat(timeAttr);
      if (isNaN(seconds)) return;

      window.dispatchEvent(
        new CustomEvent("ngobrolin:seek-video", {
          detail: { seconds },
        })
      );
    });

    // Search / filter functionality
    if (searchInput && statusText) {
      let initialDetailsOpen = details ? details.open : false;

      function performSearch() {
        const query = searchInput.value.trim().toLowerCase();

        if (!query) {
          if (clearBtn) clearBtn.classList.add("hidden");
          statusText.classList.add("hidden");
          statusText.textContent = "";
          allSegments.forEach((seg) => seg.classList.remove("hidden"));
          if (details) details.open = initialDetailsOpen;
          return;
        }

        if (clearBtn) clearBtn.classList.remove("hidden");
        if (details) details.open = true;

        let matchCount = 0;
        allSegments.forEach((seg) => {
          const text = seg.getAttribute("data-segment-text") || "";
          const matches = text.includes(query);
          if (matches) {
            seg.classList.remove("hidden");
            matchCount++;
          } else {
            seg.classList.add("hidden");
          }
        });

        statusText.classList.remove("hidden");
        if (matchCount === 0) {
          statusText.textContent = `Tidak ditemukan segmen dengan kata "${searchInput.value.trim()}".`;
        } else {
          statusText.textContent = `Ditemukan ${matchCount} segmen yang cocok.`;
        }
      }

      searchInput.addEventListener("input", performSearch);

      if (clearBtn) {
        clearBtn.addEventListener("click", () => {
          searchInput.value = "";
          performSearch();
          searchInput.focus();
        });
      }
    }

    container.setAttribute("data-transcript-initialized", "true");
  })();
</script>
