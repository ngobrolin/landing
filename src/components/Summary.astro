---
interface Props {
  videoId: string;
}

const { videoId } = Astro.props;

let summary: { brief: string; keyPoints: string[] } | null = null;

try {
  const summaries = import.meta.glob('../data/summaries/*.json', { eager: true });
  const key = `../data/summaries/${videoId}.json`;
  if (summaries[key]) {
    summary = summaries[key] as typeof summary;
  }
} catch {
  summary = null;
}

const editUrl = `https://github.com/ngobrolin/landing/edit/main/src/data/summaries/${videoId}.json`;
const keyPoints = summary?.keyPoints ?? [];
const briefClass = 'max-w-[68ch] text-ink-body leading-relaxed whitespace-pre-line';
---

{summary && (
  <section id="ringkasan" aria-labelledby="summary-heading">
    <div class="flex items-baseline justify-between gap-4 mb-4">
      <h2 id="summary-heading" class="display text-xl md:text-2xl text-ink">Poin utama</h2>
      <a
        href={editUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 min-h-11 text-sm text-ink-muted hover:text-accent-text transition shrink-0"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        Bantu Koreksi
      </a>
    </div>

    <!--
      Key points carry the page; the brief restates them at length, so it
      waits behind a fold. Without key points the brief is all there is.
    -->
    {keyPoints.length > 0 ? (
      <>
        <ul class="flex flex-col gap-3.5 max-w-[68ch]" data-testid="episode-key-points">
          {keyPoints.map((point) => (
            <li class="grid grid-cols-[0.625rem_minmax(0,1fr)] gap-x-3.5 text-[1.0625rem] leading-relaxed text-ink-body">
              <span class="mt-[0.55em] h-2.5 w-2.5 bg-highlight" aria-hidden="true"></span>
              <span>{point}</span>
            </li>
          ))}
        </ul>
        <details class="mt-3" data-testid="episode-brief">
          <summary class="inline-flex items-center min-h-11 font-semibold text-accent-text hover:text-ink transition cursor-pointer">
            Baca ringkasan lengkap
          </summary>
          <p class:list={[briefClass, 'mt-2']}>{summary.brief}</p>
        </details>
      </>
    ) : (
      <p class={briefClass}>{summary.brief}</p>
    )}
  </section>
)}
