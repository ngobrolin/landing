---
interface Props {
  videoId: string;
}

const { videoId } = Astro.props;

let summary: { brief: string; keyPoints: string[] } | null = null;

try {
  const summaries = import.meta.glob('../data/summaries/*.json', { eager: true });
  const key = `../data/summaries/${videoId}.json`;
  if (summaries[key]) {
    summary = summaries[key] as typeof summary;
  }
} catch {
  summary = null;
}

const editUrl = `https://github.com/ngobrolin/landing/edit/main/src/data/summaries/${videoId}.json`;
---

{summary && (
  <section class="mt-10" id="ringkasan" aria-labelledby="summary-heading">
    <div class="flex items-baseline justify-between gap-4 mb-5">
      <h2 id="summary-heading" class="display text-xl md:text-2xl text-ink">Ringkasan Episode</h2>
      <a
        href={editUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 min-h-11 text-sm text-ink-muted hover:text-accent-text transition shrink-0"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        Bantu Koreksi
      </a>
    </div>

    <!-- Key points before the prose: a search arrival wants the answer, then the account of how the hosts got there. -->
    <h3 class="font-semibold text-ink mb-3">Poin-poin Utama</h3>
    <ul class="grid grid-cols-1 md:grid-cols-2 gap-x-10 mb-8">
      {summary.keyPoints.map((point) => (
        <li class="border-t border-surface-border py-3 text-ink-body leading-relaxed">{point}</li>
      ))}
    </ul>

    <p class="max-w-[68ch] text-ink-body text-lg leading-relaxed whitespace-pre-line">
      {summary.brief}
    </p>
  </section>
)}
